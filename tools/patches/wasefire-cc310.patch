+    let _test = TEST.lock().unwrap();
+    let mut output = [0; 28];
+    hash(Algorithm::Sha1, b"abc", &mut output[.. 20]).unwrap();
+    assert_eq!(&output[.. 20], &hex::<20>("a9993e364706816aba3e25717850c26c9cd0d89d"));
+    hash(Algorithm::Sha224, b"abc", &mut output).unwrap();
+    assert_eq!(output, hex::<28>("23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7"));
+    hmac(Algorithm::Sha1, &[0x0b; 20], b"Hi There", &mut output[.. 20]).unwrap();
+    assert_eq!(&output[.. 20], &hex::<20>("b617318655057264e28bc0b6fb378c8ef146be00"));
+    hmac(
+        Algorithm::Sha224,
+        &[0xaa; 131],
+        b"Test Using Larger Than Block-Size Key - Hash Key First",
+        &mut output,
+    )
+    .unwrap();
+    assert_eq!(output, hex::<28>("95e9a0db962095adaebe9b2d6f0dbce2d499f112f2d2b7273fa6870e"));
+    output.fill(0xa5);
+    assert!(hash(Algorithm::Sha1, b"", &mut output).is_err());
+    assert_eq!(output, [0xa5; 28]);
+}
