+int opensk_cc310_ccm_detached(bool encrypt, const uint8_t key[16], const uint8_t nonce[13],
+                             const uint8_t *aad, size_t aad_size, const uint8_t *input,
+                             size_t size, uint8_t *output, uint8_t tag[4])
+{
+    psa_key_attributes_t attr = aes128_attributes();
+    cc3xx_aead_operation_t operation = {0};
+    psa_algorithm_t alg = PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, 4);
+    int result = encrypt ? cc3xx_aead_encrypt_setup(&operation, &attr, key, 16, alg)
+                         : cc3xx_aead_decrypt_setup(&operation, &attr, key, 16, alg);
+    if (!result) result = cc3xx_aead_set_lengths(&operation, aad_size, size);
+    if (!result) result = cc3xx_aead_set_nonce(&operation, nonce, 13);
+    if (!result) result = cc3xx_aead_update_ad(&operation, aad, aad_size);
+    size_t written = 0, tail = 0, tag_size = 0;
+    if (!result) result = cc3xx_aead_update(&operation, input, size, output, size, &written);
+    if (!result && written > size) result = PSA_ERROR_CORRUPTION_DETECTED;
+    if (!result) {
+        result = encrypt ? cc3xx_aead_finish(&operation, output + written, size - written,
+                                              &tail, tag, 4, &tag_size)
+                         : cc3xx_aead_verify(&operation, output + written, size - written,
+                                              &tail, tag, 4);
+    }
+    if (!result && (written + tail != size || (encrypt && tag_size != 4)))
+        result = PSA_ERROR_CORRUPTION_DETECTED;
+    int aborted = cc3xx_aead_abort(&operation);
+    return result ? result : aborted;
+}
