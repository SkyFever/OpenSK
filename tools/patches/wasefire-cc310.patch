+
+hardware-crypto-rng = ["dep:nrf-cc310", "nrf-cc310/random"]
+
+hardware-crypto-ed25519 = ["_crypto", "dep:nrf-cc310", "nrf-cc310/ed25519",
+  "wasefire-scheduler/board-api-crypto-ed25519"]
