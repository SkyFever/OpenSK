+// SPDX-License-Identifier: Apache-2.0
+//! Streaming SHA/HMAC adapters for the published Nordic PSA driver.
+use alloc::boxed::Box;
+
+use digest::crypto_common::{BlockSizeUser, KeySizeUser};
+use digest::{
+    FixedOutput, HashMarker, InvalidLength, Key, KeyInit, MacMarker, Output, OutputSizeUser, Update,
+};
+use typenum::{U32, U64};
+use wasefire_board_api::crypto::{GlobalError, WithError};
+use wasefire_board_api::{Error, Supported};
+use zeroize::{Zeroize, Zeroizing};
+
+use crate::{driver, traced_driver};
+
+static ERROR: GlobalError = GlobalError::new();
+fn record(failed: &mut bool, result: Result<(), Error>) {
+    if ERROR.record(result).is_none() {
+        *failed = true;
+    }
+}
+
+// Driver operation addresses stay stable as scheduler objects are moved.
+pub struct Sha256 {
+    state: Box<Zeroizing<[u32; 60]>>,
+    failed: bool,
+}
+impl Supported for Sha256 {}
+impl Default for Sha256 {
+    fn default() -> Self {
+        let mut value = Self { state: Box::new(Zeroizing::new([0; 60])), failed: false };
+        // SAFETY: The 60-word, u32-aligned state matches cc3xx_hash_operation_t.
+        record(
+            &mut value.failed,
+            traced_driver(7, || unsafe { ffi::opensk_cc310_hash_setup(value.state.as_mut_ptr()) }),
+        );
+        value
+    }
+}
