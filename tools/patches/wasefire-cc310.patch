+// SPDX-License-Identifier: Apache-2.0
+//! Finite, RAM-only hardware checks. Does not provision credentials or reset a device.
+use alloc::vec;
+
+use wasefire_board_api::Error;
+use wasefire_board_api::crypto::ed25519::Api;
+
+use crate::{Ed25519, aes128, chacha20poly1305, ecc, hashes, rsa, srp, x25519};
+fn check(ok: bool) -> Result<(), Error> {
+    if ok { Ok(()) } else { Err(Error::world(0)) }
+}
+fn hex<const N: usize>(value: &str) -> [u8; N] {
+    assert_eq!(value.len(), N * 2);
+    let mut result = [0; N];
+    for (i, x) in result.iter_mut().enumerate() {
+        *x = u8::from_str_radix(&value[2 * i .. 2 * i + 2], 16).unwrap();
+    }
+    result
+}
+pub fn run(mut progress: impl FnMut(u32)) -> Result<(), Error> {
+    progress(1);
+    let (mut a, mut b) = ([0; 32], [0; 32]);
+    crate::fill_entropy(&mut a)?;
+    crate::fill_entropy(&mut b)?;
+    check(a != b && a.iter().any(|&x| x != 0) && b.iter().any(|&x| x != 0))?;
+    crate::fill_random(&mut a)?;
+    crate::fill_random(&mut b)?;
+    check(a != b)?;
+    progress(2);
+    let mut digest = [0; 32];
+    hashes::hash(hashes::Algorithm::Sha1, b"abc", &mut digest[.. 20])?;
+    check(digest[.. 20] == hex::<20>("a9993e364706816aba3e25717850c26c9cd0d89d"))?;
+    hashes::hash(hashes::Algorithm::Sha224, b"abc", &mut digest[.. 28])?;
+    check(digest[.. 28] == hex::<28>("23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7"))?;
+    hashes::hash(hashes::Algorithm::Sha256, b"abc", &mut digest)?;
+    check(digest == hex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))?;
+    hashes::hmac(hashes::Algorithm::Sha1, &[0x0b; 20], b"Hi There", &mut digest[.. 20])?;
+    check(digest[.. 20] == hex::<20>("b617318655057264e28bc0b6fb378c8ef146be00"))?;
+    hashes::hmac(
+        hashes::Algorithm::Sha224,
+        &[0xaa; 131],
+        b"Test Using Larger Than Block-Size Key - Hash Key First",
+        &mut digest[.. 28],
+    )?;
+    check(digest[.. 28] == hex::<28>("95e9a0db962095adaebe9b2d6f0dbce2d499f112f2d2b7273fa6870e"))?;
+    progress(3);
+    let key = hex::<16>("2b7e151628aed2a6abf7158809cf4f3c");
+    let data = hex::<16>("6bc1bee22e409f96e93d7e117393172a");
+    for (mode, iv, answer) in [
+        (aes128::Mode::Ecb, [0; 16], "3ad77bb40d7a3660a89ecaf32466ef97"),
+        (
+            aes128::Mode::Cbc,
+            hex("000102030405060708090a0b0c0d0e0f"),
+            "7649abac8119b246cee98e9b12e9197d",
+        ),
+        (
+            aes128::Mode::Ctr,
+            hex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"),
+            "874d6191b620e3261bef6864990db6ce",
+        ),
+    ] {
+        let (mut out, mut clear) = ([0; 16], [0; 16]);
+        aes128::cipher(mode, true, &key, &iv, &data, &mut out)?;
+        check(out == hex::<16>(answer))?;
+        aes128::cipher(mode, false, &key, &iv, &out, &mut clear)?;
+        check(clear == data)?;
+    }
+    let mut mac = [0; 16];
+    aes128::cmac(&key, b"", &mut mac)?;
+    check(mac == hex("bb1d6929e95937287fa37d129b756746"))?;
+    aes128::cbc_mac(&key, &data, &mut mac)?;
+    check(mac == hex("3ad77bb40d7a3660a89ecaf32466ef97"))?;
+    let (mut cipher, mut clear, mut tag) = ([0; 16], [0; 16], [0; 8]);
+    aes128::ccm_encrypt(&key, &[0x11; 13], b"aad", &data, &mut cipher, &mut tag)?;
+    aes128::ccm_decrypt(&key, &[0x11; 13], b"aad", &cipher, &tag, &mut clear)?;
+    check(clear == data)?;
+    let mut star = [0; 16];
+    aes128::ccm_star_no_tag(&key, &[0x11; 13], &data, &mut star)?;
+    check(star == cipher)?;
+    tag[0] ^= 1;
+    check(aes128::ccm_decrypt(&key, &[0x11; 13], b"aad", &cipher, &tag, &mut clear).is_err())?;
+    progress(4);
+    let seed = hex::<32>("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb");
+    let (mut r, mut s, mut public) = ([0; 32], [0; 32], [0; 32]);
+    Ed25519::public(&seed, &mut public)?;
+    Ed25519::sign(&seed, &[0x72], &mut r, &mut s)?;
+    check(r == hex("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da"))?;
+    check(s == hex("085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"))?;
+    check(Ed25519::verify(&public, &[0x72], &r, &s)?)?;
+    check(!Ed25519::verify(&public, &[0x73], &r, &s)?)?;
+    let mut fresh = [0; 32];
+    Ed25519::generate(&mut fresh)?;
+    Ed25519::public(&fresh, &mut public)?;
+    Ed25519::sign(&fresh, b"random Ed25519", &mut r, &mut s)?;
+    check(Ed25519::verify(&public, b"random Ed25519", &r, &s)?)?;
+    Ed25519::drop_private(&mut fresh)?;
+    progress(5);
+    let private = hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
+    x25519::public(&private, &mut public)?;
+    check(public == hex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"))?;
+    let peer = hex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f");
+    x25519::shared(&private, &peer, &mut a)?;
+    check(a == hex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"))?;
+    check(x25519::shared(&private, &[0; 32], &mut a).is_err())?;
+    progress(6);
+    for curve in [
+        ecc::Curve::P192,
+        ecc::Curve::P224,
+        ecc::Curve::P256,
+        ecc::Curve::P384,
+        ecc::Curve::Secp192k1,
+        ecc::Curve::Secp224k1,
+        ecc::Curve::Secp256k1,
+        ecc::Curve::BrainpoolP256r1,
+    ] {
+        let size = curve.scalar_size();
+        let mut key = zeroize::Zeroizing::new(vec![0; size]);
+        key[size - 1] = 1;
+        let mut pubkey = vec![0; curve.public_size()];
+        ecc::public(curve, &key, &mut pubkey)?;
+        let mut sig = vec![0; 2 * size];
+        ecc::sign(curve, &key, &[0x42; 32], &mut sig)?;
+        check(ecc::verify(curve, &pubkey, &[0x42; 32], &sig)?)?;
+        check(!ecc::verify(curve, &pubkey, &[0x43; 32], &sig)?)?;
+        let mut secret = zeroize::Zeroizing::new(vec![0; size]);
+        ecc::shared(curve, &key, &pubkey, &mut secret)?;
+        check(secret.as_slice() == &pubkey[1 .. 1 + size])?;
+        ecc::generate(curve, &mut key)?;
+        ecc::public(curve, &key, &mut pubkey)?;
+    }
+    progress(7);
+    let bits = rsa::Bits::B2048;
+    let private = rsa::generate(bits)?;
+    let public = rsa::public(bits, &private)?;
+    for padding in [rsa::SignaturePadding::Pkcs1v15, rsa::SignaturePadding::Pss] {
+        let mut sig = [0; 256];
+        rsa::sign(bits, padding, &private, &[0x42; 32], &mut sig)?;
+        check(rsa::verify(bits, padding, &public, &[0x42; 32], &sig)?)?;
+        check(!rsa::verify(bits, padding, &public, &[0x43; 32], &sig)?)?;
+    }
+    for padding in [rsa::EncryptionPadding::Pkcs1v15, rsa::EncryptionPadding::OaepSha256] {
+        let mut cipher = [0; 256];
+        rsa::encrypt(bits, padding, &public, b"", b"CC310 RSA", &mut cipher)?;
+        let clear = rsa::decrypt(bits, padding, &private, b"", &cipher)?;
+        check(clear.as_slice() == b"CC310 RSA")?;
+    }
+    progress(8);
+    srp_roundtrip(false)?;
+    srp_roundtrip(true)?;
+    progress(9);
+    let key = hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f");
+    let nonce = hex("070000004041424344454647");
+    let aad = hex::<12>("50515253c0c1c2c3c4c5c6c7");
+    let message=b"Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
+    let (mut cipher, mut clear, mut tag) = ([0; 114], [0; 114], [0; 16]);
+    chacha20poly1305::encrypt(&key, &nonce, &aad, message, &mut cipher, &mut tag)?;
+    check(tag == hex("1ae10b594f09e26a7e902ecbd0600691"))?;
+    chacha20poly1305::decrypt(&key, &nonce, &aad, &cipher, &tag, &mut clear)?;
+    check(&clear == message)?;
+    tag[0] ^= 1;
+    check(chacha20poly1305::decrypt(&key, &nonce, &aad, &cipher, &tag, &mut clear).is_err())?;
+    Ok(())
+}
+fn srp_roundtrip(tamper: bool) -> Result<(), Error> {
+    // RFC5054's 3072-bit group: RFC3526 prime, generator 5.
+    let modulus=hex::<384>("");
+    let mut user = srp::Context::new(
+        srp::Entity::User,
+        &modulus,
+        5,
+        b"cc310-test",
+        Some(b"ephemeral-test-password"),
+    )?;
+    let mut host = srp::Context::new(srp::Entity::Host, &modulus, 5, b"cc310-test", None)?;
+    let mut salt = [0; 16];
+    let verifier = user.verifier(&mut salt)?;
+    let a = user.public(None)?;
+    let b = host.public(Some(&verifier))?;
+    let mut session = user.user_proof(&salt, &a, &b)?;
+    if tamper {
+        session.proof[0] ^= 1;
+        check(host.host_proof(&salt, &verifier, &a, &b, &session.proof).is_err())
+    } else {
+        let host_session = host.host_proof(&salt, &verifier, &a, &b, &session.proof)?;
+        check(session.key == host_session.key)?;
+        user.user_verify(&session.key, &a, &session.proof, &host_session.proof)
+    }
+}
diff --git a/crates/runner-nordic/crates/cc310/src/srp.rs b/crates/runner-nordic/crates/cc310/src/srp.rs
new file mode 100644
index 00000000..898d9f4d
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/src/srp.rs
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Nordic legacy SRP-6a/SHA-256, available on ARM. Caller supplies a trusted group.
+//! A context belongs to one exchange. Do not reuse ephemeral keys across exchanges.
+use alloc::vec;
+use alloc::vec::Vec;
+use core::ffi::c_void;
+
+use wasefire_board_api::Error;
+use zeroize::{Zeroize, Zeroizing};
+
+use crate::{driver, length};
+
+#[derive(Clone, Copy)]
+pub enum Entity {
+    User,
+    Host,
+}
+pub struct Session {
+    pub proof: [u8; 32],
+    pub key: Zeroizing<Vec<u8>>,
+}
+pub struct Context {
+    memory: Zeroizing<Vec<u32>>,
+    modulus_size: usize,
+    key_size: usize,
+    host: bool,
+}
+impl Context {
+    /// The modulus must be a trusted prime of 1024,1536,2048 or 3072 bits.
+    pub fn new(
+        entity: Entity, modulus: &[u8], generator: u8, user: &[u8], password: Option<&[u8]>,
+    ) -> Result<Self, Error> {
+        let host = matches!(entity, Entity::Host);
+        if !matches!(modulus.len(), 128 | 192 | 256 | 384)
+            || modulus[0] & 0x80 == 0
+            || modulus[modulus.len() - 1] & 1 == 0
+            || generator < 2
+            || user.is_empty()
+            || (!host && password.is_none_or(|x| x.is_empty()))
+            || password.is_some_and(|x| x.is_empty())
+        {
+            return Err(Error::user(0));
+        }
+        // SAFETY: Size getter is a pure ABI query. The C shim statically verifies u32 alignment.
+        let size = unsafe { ffi::opensk_cc310_srp_size() };
+        if size == 0 || !size.is_multiple_of(4) || size > 8192 {
+            return Err(Error::world(0));
+        }
+        let mut result = Self {
+            memory: Zeroizing::new(vec![0; size / 4]),
+            modulus_size: modulus.len(),
+            key_size: 0,
+            host,
+        };
+        // The legacy API declares mutable inputs; give it owned, fully sized buffers.
+        let mut n = Zeroizing::new(vec![0; 384]);
+        n[.. modulus.len()].copy_from_slice(modulus);
+        let mut user = Zeroizing::new(user.to_vec());
+        let mut password = Zeroizing::new(password.unwrap_or_default().to_vec());
+        // SAFETY: Context and maximum-width modulus are correctly sized; other inputs are live
+        // copies.
+        driver(|| unsafe {
+            ffi::opensk_cc310_srp_init(
+                result.ptr(),
+                host,
+                n.as_mut_ptr(),
+                modulus.len(),
+                generator,
+                user.as_mut_ptr(),
+                user.len(),
+                if password.is_empty() { core::ptr::null_mut() } else { password.as_mut_ptr() },
+                password.len(),
+            )
+        })?;
+        // SAFETY: The successfully initialized, exclusively owned context is live.
+        result.key_size = unsafe { ffi::opensk_cc310_srp_key_size(result.ptr()) };
+        if result.key_size == 0 || result.key_size > 128 {
+            return Err(Error::world(0));
+        }
+        Ok(result)
+    }
+    fn ptr(&mut self) -> *mut c_void {
+        self.memory.as_mut_ptr().cast()
+    }
+    fn salt(salt: &[u8]) -> Result<(), Error> {
+        if (8 ..= 64).contains(&salt.len()) { Ok(()) } else { Err(Error::user(0)) }
+    }
+    fn modulus(&self, value: &[u8]) -> Result<Zeroizing<Vec<u8>>, Error> {
+        length(value, self.modulus_size)?;
+        let mut result = Zeroizing::new(vec![0; 384]);
+        result[.. value.len()].copy_from_slice(value);
+        Ok(result)
+    }
+    /// Creates fresh salt and the password verifier using the initialized credentials.
+    pub fn verifier(&mut self, salt: &mut [u8]) -> Result<Zeroizing<Vec<u8>>, Error> {
+        Self::salt(salt)?;
+        let mut s = Zeroizing::new(salt.to_vec());
+        let mut v = Zeroizing::new(vec![0; 384]);
+        // SAFETY: Context is exclusive; legacy fixed-width output is fully reserved.
+        driver(|| unsafe {
+            ffi::opensk_cc310_srp_verifier(self.ptr(), s.as_mut_ptr(), s.len(), v.as_mut_ptr())
+        })?;
+        salt.copy_from_slice(&s);
+        v[self.modulus_size ..].zeroize();
+        v.truncate(self.modulus_size);
+        Ok(v)
+    }
+    pub fn public(&mut self, verifier: Option<&[u8]>) -> Result<Vec<u8>, Error> {
+        let mut v = if self.host {
+            self.modulus(verifier.ok_or(Error::user(0))?)?
+        } else {
+            if verifier.is_some() {
+                return Err(Error::user(0));
+            }
+            Zeroizing::new(vec![0; 384])
+        };
+        let mut output = vec![0; 384];
+        // SAFETY: All legacy modulus arrays have their full 384-byte capacity.
+        driver(|| unsafe {
+            ffi::opensk_cc310_srp_public(self.ptr(), self.host, v.as_mut_ptr(), output.as_mut_ptr())
+        })?;
+        output.truncate(self.modulus_size);
+        Ok(output)
+    }
+    pub fn user_proof(&mut self, salt: &[u8], a: &[u8], b: &[u8]) -> Result<Session, Error> {
+        if self.host {
+            return Err(Error::user(0));
+        }
+        Self::salt(salt)?;
+        let mut salt = Zeroizing::new(salt.to_vec());
+        let (mut a, mut b) = (self.modulus(a)?, self.modulus(b)?);
+        let mut proof = [0; 64];
+        let mut key = Zeroizing::new(vec![0; 128]);
+        // SAFETY: Fixed-width legacy buffers and exclusive initialized context are live.
+        driver(|| unsafe {
+            ffi::opensk_cc310_srp_user_proof(
+                self.ptr(),
+                salt.as_mut_ptr(),
+                salt.len(),
+                a.as_mut_ptr(),
+                b.as_mut_ptr(),
+                proof.as_mut_ptr(),
+                key.as_mut_ptr(),
+            )
+        })?;
+        key[self.key_size ..].zeroize();
+        key.truncate(self.key_size);
+        Ok(Session { proof: proof[.. 32].try_into().unwrap(), key })
+    }
+    pub fn host_proof(
+        &mut self, salt: &[u8], verifier: &[u8], a: &[u8], b: &[u8], user_proof: &[u8; 32],
+    ) -> Result<Session, Error> {
+        if !self.host {
+            return Err(Error::user(0));
+        }
+        Self::salt(salt)?;
+        let mut salt = Zeroizing::new(salt.to_vec());
+        let (mut v, mut a, mut b) = (self.modulus(verifier)?, self.modulus(a)?, self.modulus(b)?);
+        let mut user = [0; 64];
+        user[.. 32].copy_from_slice(user_proof);
+        let mut proof = [0; 64];
+        let mut key = Zeroizing::new(vec![0; 128]);
+        // SAFETY: Every legacy fixed-width output/input is fully allocated.
+        driver(|| unsafe {
+            ffi::opensk_cc310_srp_host_proof(
+                self.ptr(),
+                salt.as_mut_ptr(),
+                salt.len(),
+                v.as_mut_ptr(),
+                a.as_mut_ptr(),
+                b.as_mut_ptr(),
+                user.as_mut_ptr(),
+                proof.as_mut_ptr(),
+                key.as_mut_ptr(),
+            )
+        })?;
+        key[self.key_size ..].zeroize();
+        key.truncate(self.key_size);
+        Ok(Session { proof: proof[.. 32].try_into().unwrap(), key })
+    }
+    pub fn user_verify(
+        &mut self, key: &[u8], a: &[u8], user_proof: &[u8; 32], host_proof: &[u8; 32],
+    ) -> Result<(), Error> {
+        if self.host {
+            return Err(Error::user(0));
+        }
+        length(key, self.key_size)?;
+        let mut k = Zeroizing::new(vec![0; 128]);
+        k[.. key.len()].copy_from_slice(key);
+        let mut a = self.modulus(a)?;
+        let (mut user, mut host) = ([0; 64], [0; 64]);
+        user[.. 32].copy_from_slice(user_proof);
+        host[.. 32].copy_from_slice(host_proof);
+        // SAFETY: Full legacy buffers and exclusive context remain alive throughout the call.
+        driver(|| unsafe {
+            ffi::opensk_cc310_srp_user_verify(
+                self.ptr(),
+                k.as_mut_ptr(),
+                a.as_mut_ptr(),
+                user.as_mut_ptr(),
+                host.as_mut_ptr(),
+            )
+        })
+    }
+}
+mod ffi {
+    use core::ffi::c_void;
+    unsafe extern "C" {
+        pub fn opensk_cc310_srp_size() -> usize;
+        pub fn opensk_cc310_srp_key_size(ctx: *mut c_void) -> usize;
+        pub fn opensk_cc310_srp_init(
+            ctx: *mut c_void, host: bool, modulus: *mut u8, size: usize, generator: u8,
+            user: *mut u8, user_size: usize, password: *mut u8, password_size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_srp_verifier(
+            ctx: *mut c_void, salt: *mut u8, size: usize, verifier: *mut u8,
+        ) -> i32;
+        pub fn opensk_cc310_srp_public(
+            ctx: *mut c_void, host: bool, verifier: *mut u8, output: *mut u8,
+        ) -> i32;
+        pub fn opensk_cc310_srp_user_proof(
+            ctx: *mut c_void, salt: *mut u8, salt_size: usize, a: *mut u8, b: *mut u8,
+            proof: *mut u8, key: *mut u8,
+        ) -> i32;
+        pub fn opensk_cc310_srp_host_proof(
+            ctx: *mut c_void, salt: *mut u8, salt_size: usize, verifier: *mut u8, a: *mut u8,
+            b: *mut u8, user_proof: *mut u8, proof: *mut u8, key: *mut u8,
+        ) -> i32;
+        pub fn opensk_cc310_srp_user_verify(
+            ctx: *mut c_void, key: *mut u8, a: *mut u8, user_proof: *mut u8, host_proof: *mut u8,
+        ) -> i32;
+    }
+}
diff --git a/crates/runner-nordic/crates/cc310/src/symmetric.rs b/crates/runner-nordic/crates/cc310/src/symmetric.rs
new file mode 100644
index 00000000..f539f82a
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/src/symmetric.rs
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Streaming SHA/HMAC adapters for the published Nordic PSA driver.
+use alloc::boxed::Box;
+
+use digest::crypto_common::{BlockSizeUser, KeySizeUser};
+use digest::{
+    FixedOutput, HashMarker, InvalidLength, Key, KeyInit, MacMarker, Output, OutputSizeUser, Update,
+};
+use typenum::{U32, U64};
+use wasefire_board_api::crypto::{GlobalError, WithError};
+use wasefire_board_api::{Error, Supported};
+use zeroize::{Zeroize, Zeroizing};
+
+use crate::{driver, traced_driver};
+
+static ERROR: GlobalError = GlobalError::new();
+fn record(failed: &mut bool, result: Result<(), Error>) {
+    if ERROR.record(result).is_none() {
+        *failed = true;
+    }
+}
+
+// Driver operation addresses stay stable as scheduler objects are moved.
+pub struct Sha256 {
+    state: Box<Zeroizing<[u32; 60]>>,
+    failed: bool,
+}
+impl Supported for Sha256 {}
+impl Default for Sha256 {
+    fn default() -> Self {
+        let mut value = Self { state: Box::new(Zeroizing::new([0; 60])), failed: false };
+        // SAFETY: The 60-word, u32-aligned state matches cc3xx_hash_operation_t.
+        record(
+            &mut value.failed,
+            traced_driver(7, || unsafe { ffi::opensk_cc310_hash_setup(value.state.as_mut_ptr()) }),
+        );
+        value
+    }
+}
+impl BlockSizeUser for Sha256 {
+    type BlockSize = U64;
+}
+impl OutputSizeUser for Sha256 {
+    type OutputSize = U32;
+}
+impl HashMarker for Sha256 {}
+impl WithError for Sha256 {
+    fn with_error<T>(operation: impl FnOnce() -> T) -> Result<T, Error> {
+        ERROR.with(operation)
+    }
+}
+impl Update for Sha256 {
+    fn update(&mut self, data: &[u8]) {
+        if self.failed {
+            ERROR.record::<()>(Err(Error::world(0)));
+            return;
+        }
+        // SAFETY: The state is live and data is readable for the duration of the call.
+        record(
+            &mut self.failed,
+            traced_driver(7, || unsafe {
+                ffi::opensk_cc310_hash_update(self.state.as_mut_ptr(), data.as_ptr(), data.len())
+            }),
+        );
+    }
+}
+impl FixedOutput for Sha256 {
+    fn finalize_into(mut self, output: &mut Output<Self>) {
+        output.zeroize();
+        if self.failed {
+            ERROR.record::<()>(Err(Error::world(0)));
+            return;
+        }
+        // SAFETY: output is 32 bytes and the state has the required layout.
+        record(
+            &mut self.failed,
+            traced_driver(7, || unsafe {
+                ffi::opensk_cc310_hash_finish(self.state.as_mut_ptr(), output.as_mut_ptr())
+            }),
+        );
+        if self.failed {
+            output.zeroize();
+        }
+    }
+}
+impl Drop for Sha256 {
+    fn drop(&mut self) {
+        // SAFETY: The state is valid or all-zero after a failed setup. Rust wipes it afterwards.
+        let _ = driver(|| unsafe { ffi::opensk_cc310_hash_abort(self.state.as_mut_ptr()) });
+    }
+}
+
+pub struct HmacSha256 {
+    state: Box<Zeroizing<[u32; 79]>>,
+    failed: bool,
+}
+impl Supported for HmacSha256 {}
+impl KeySizeUser for HmacSha256 {
+    type KeySize = U64;
+}
+impl OutputSizeUser for HmacSha256 {
+    type OutputSize = U32;
+}
+impl MacMarker for HmacSha256 {}
+impl WithError for HmacSha256 {
+    fn with_error<T>(operation: impl FnOnce() -> T) -> Result<T, Error> {
+        ERROR.with(operation)
+    }
+}
+impl KeyInit for HmacSha256 {
+    fn new(key: &Key<Self>) -> Self {
+        Self::new_from_slice(key).unwrap()
+    }
+    fn new_from_slice(key: &[u8]) -> Result<Self, InvalidLength> {
+        // RFC 2104 normalization supports empty/short and arbitrarily long keys.
+        let mut normalized = Zeroizing::new([0; 64]);
+        if key.len() > 64 {
+            use digest::Digest;
+            normalized[.. 32].copy_from_slice(&Sha256::digest(key));
+        } else {
+            normalized[.. key.len()].copy_from_slice(key);
+        }
+        let mut value = Self { state: Box::new(Zeroizing::new([0; 79])), failed: false };
+        // SAFETY: Both pointers have the exact layouts of the published C API.
+        record(
+            &mut value.failed,
+            traced_driver(2, || unsafe {
+                ffi::opensk_cc310_hmac_setup(value.state.as_mut_ptr(), normalized.as_ptr())
+            }),
+        );
+        Ok(value)
+    }
+}
+impl Update for HmacSha256 {
+    fn update(&mut self, data: &[u8]) {
+        if self.failed {
+            ERROR.record::<()>(Err(Error::world(0)));
+            return;
+        }
+        // SAFETY: The state is live and data is readable for the duration of the call.
+        record(
+            &mut self.failed,
+            traced_driver(2, || unsafe {
+                ffi::opensk_cc310_hmac_update(self.state.as_mut_ptr(), data.as_ptr(), data.len())
+            }),
+        );
+    }
+}
+impl FixedOutput for HmacSha256 {
+    fn finalize_into(mut self, output: &mut Output<Self>) {
+        output.zeroize();
+        if self.failed {
+            ERROR.record::<()>(Err(Error::world(0)));
+            return;
+        }
+        // SAFETY: output is 32 bytes and the state has the required layout.
+        record(
+            &mut self.failed,
+            traced_driver(2, || unsafe {
+                ffi::opensk_cc310_hmac_finish(self.state.as_mut_ptr(), output.as_mut_ptr())
+            }),
+        );
+        if self.failed {
+            output.zeroize();
+        }
+    }
+}
+impl Drop for HmacSha256 {
+    fn drop(&mut self) {
+        // SAFETY: The state is valid or all-zero after a failed setup. Rust wipes it afterwards.
+        let _ = driver(|| unsafe { ffi::opensk_cc310_hmac_abort(self.state.as_mut_ptr()) });
+    }
+}
