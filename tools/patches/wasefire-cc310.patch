+int opensk_cc310_aes128_cipher(uint32_t mode, bool encrypt, const uint8_t key[16],
+                               const uint8_t iv[16], const uint8_t *input, size_t size,
+                               uint8_t *output, size_t capacity)
+{
+    psa_algorithm_t algorithm;
+    switch (mode) {
+    case 0: algorithm = PSA_ALG_ECB_NO_PADDING; break;
+    case 1: algorithm = PSA_ALG_CBC_NO_PADDING; break;
+    case 2: algorithm = PSA_ALG_CTR; break;
+    default: return PSA_ERROR_NOT_SUPPORTED;
+    }
+    psa_key_attributes_t attr = aes128_attributes();
+    cc3xx_cipher_operation_t operation = {0};
+    int result = encrypt ? cc3xx_cipher_encrypt_setup(&operation, &attr, key, 16, algorithm)
+                         : cc3xx_cipher_decrypt_setup(&operation, &attr, key, 16, algorithm);
+    if (!result && mode != 0) {
+        result = cc3xx_cipher_set_iv(&operation, iv, 16);
+    }
+    size_t written = 0, tail = 0;
+    if (!result) {
+        result = cc3xx_cipher_update(&operation, input, size, output, capacity, &written);
+    }
+    if (!result && written > capacity) {
+        result = PSA_ERROR_CORRUPTION_DETECTED;
+    }
+    if (!result) {
+        result = cc3xx_cipher_finish(&operation, output + written, capacity - written, &tail);
+    }
+    if (!result && (tail > capacity - written || written + tail != size)) {
+        result = PSA_ERROR_CORRUPTION_DETECTED;
+    }
+    int aborted = cc3xx_cipher_abort(&operation);
+    return result ? result : aborted;
+}
+int opensk_cc310_aes128_mac(bool cmac, const uint8_t key[16], const uint8_t *data,
+                            size_t size, uint8_t output[16])
+{
+    psa_key_attributes_t attr = aes128_attributes();
+    size_t written = 0;
+    int result = cc3xx_mac_compute(&attr, key, 16, cmac ? PSA_ALG_CMAC : PSA_ALG_CBC_MAC,
+                                   data, size, output, 16, &written);
+    return result ? result : (written == 16 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+int opensk_cc310_aes128_ccm(bool encrypt, const uint8_t key[16], const uint8_t *nonce,
+                            size_t nonce_size, const uint8_t *aad, size_t aad_size,
+                            const uint8_t *input, size_t input_size, uint8_t *output,
+                            size_t output_size, size_t tag_size)
+{
+    psa_key_attributes_t attr = aes128_attributes();
+    psa_algorithm_t alg = PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, tag_size);
+    size_t written = 0;
+    int result = encrypt
+        ? cc3xx_aead_encrypt(&attr, key, 16, alg, nonce, nonce_size, aad, aad_size,
+                              input, input_size, output, output_size, &written)
+        : cc3xx_aead_decrypt(&attr, key, 16, alg, nonce, nonce_size, aad, aad_size,
+                              input, input_size, output, output_size, &written);
+    return result ? result : (written == output_size ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
