new file mode 100644
index 00000000..c35b046d
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/build.rs
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: Apache-2.0
+use std::path::PathBuf;
+use std::process::Command;
+
+fn run(command: &mut Command) {
+    let status = command.status().expect("could not start CC310 C toolchain");
+    assert!(status.success(), "CC310 C toolchain failed");
+}
+
+fn main() {
+    // Host tests exercise the Rust adapter with a software driver model.
+    if std::env::var("CARGO_CFG_TARGET_ARCH").as_deref() != Ok("arm") {
+        return;
+    }
+    assert_eq!(
+        std::env::var("TARGET").unwrap(),
+        "thumbv7em-none-eabi",
+        "CC310 archive requires the Cortex-M4 soft-float ABI"
+    );
+    let cache = std::env::var_os("OPENSK_CC310_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("../../../../.root/cc310"));
+    let cache = cache
+        .canonicalize()
+        .expect("CC310 dependencies are missing: run python3 tools/setup_cc310.py from OpenSK");
+    println!("cargo::rerun-if-changed={}", cache.display());
+    let nordic = cache.join("nrfxlib/crypto");
+    let out = PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+    let cc = std::env::var_os("CC310_CC").unwrap_or_else(|| "clang-18".into());
+    run(Command::new(cc)
+        .args([
+            "--target=thumbv7em-none-eabi",
+            "-mcpu=cortex-m4",
+            "-mthumb",
+            "-mfloat-abi=soft",
+            "-std=c11",
+            "-Os",
+            "-ffreestanding",
+            "-fno-builtin",
+            "-ffunction-sections",
+            "-fdata-sections",
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            "-DMBEDTLS_CONFIG_FILE=\"cc310_config.h\"",
+        ])
+        .arg("-I")
+        .arg("src")
+        .arg("-I")
+        .arg(cache.join("mbedtls/include"))
+        .arg("-I")
+        .arg(nordic.join("nrf_cc310_mbedcrypto/include"))
+        .arg("-I")
+        .arg(nordic.join("nrf_cc310_platform/include"))
+        .args(["-c", "src/cc310.c", "-o"])
+        .arg(out.join("cc310.o")));
+    let ar = std::env::var_os("CC310_AR").unwrap_or_else(|| "llvm-ar".into());
+    run(Command::new(ar).arg("crs").arg(out.join("libopensk_cc310.a")).arg(out.join("cc310.o")));
+    println!("cargo::rustc-link-search=native={}", out.display());
+    println!("cargo::rustc-link-lib=static=opensk_cc310");
+    for (directory, name) in [
+        ("nrf_cc310_mbedcrypto", "nrf_cc310_psa_crypto_0.9.19"),
+        ("nrf_cc310_mbedcrypto", "nrf_cc310_core_0.9.19"),
+        ("nrf_cc310_platform", "nrf_cc310_platform_0.9.19"),
+    ] {
+        let path = nordic.join(directory).join("lib/cortex-m4/soft-float/no-interrupts");
+        assert!(path.join(format!("lib{name}.a")).is_file(), "missing CC310 archive");
+        println!("cargo::rustc-link-search=native={}", path.display());
+        println!("cargo::rustc-link-lib=static={name}");
+        println!("cargo::rerun-if-changed={}", path.display());
+    }
+    for name in ["OPENSK_CC310_DIR", "CC310_CC", "CC310_AR"] {
+        println!("cargo::rerun-if-env-changed={name}");
+    }
+    println!("cargo::rerun-if-changed=src/cc310.c");
+    println!("cargo::rerun-if-changed=src/cc310_config.h");
+}
diff --git a/crates/runner-nordic/crates/cc310/src/cc310.c b/crates/runner-nordic/crates/cc310/src/cc310.c
new file mode 100644
index 00000000..6cfd36aa
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/src/cc310.c
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include <psa/crypto.h>
+#include <cc3xx_psa_asymmetric_signature.h>
+#include <cc3xx_psa_key_agreement.h>
+#include <cc3xx_psa_key_generation.h>
+#include <cc3xx_psa_hash.h>
+#include <cc3xx_psa_mac.h>
+#include <nrf_cc3xx_platform.h>
+
+/* The pinned Nordic driver reads these fields directly. Do not use SE layout. */
+_Static_assert(offsetof(psa_key_attributes_t, MBEDTLS_PRIVATE(type)) == 0, "PSA type ABI");
+_Static_assert(offsetof(psa_key_attributes_t, MBEDTLS_PRIVATE(bits)) == 2, "PSA bits ABI");
+_Static_assert(offsetof(psa_hash_operation_t, MBEDTLS_PRIVATE(ctx)) == 4, "PSA hash ABI");
+_Static_assert(sizeof(psa_hash_operation_t) == 244, "PSA hash context ABI");
+
+static psa_key_attributes_t attributes(bool public_key)
+{
+    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+    psa_set_key_type(&attr, public_key ? PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1)
+                                      : PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
+    psa_set_key_bits(&attr, 256);
+    return attr;
+}
+
+/* Wasefire serializes crypto calls in Rust. Its IRQ handlers never use CC310.
+ * Nordic's no-interrupts archive polls CC310 while USB IRQs remain enabled. */
+void nrf_cc3xx_platform_mutex_init(void) {}
+
+int opensk_cc310_init(void)
+{
+    if (nrf_cc3xx_platform_is_initialized()) {
+        return 0;
+    }
+    nrf_cc3xx_platform_mutex_init();
+    /* The runner supplies PSA random requests. Nordic ECC also uses its own DRBG. */
+    return nrf_cc3xx_platform_init_no_rng();
+}
+
+int opensk_cc310_generate(uint8_t private_key[32])
+{
+    psa_key_attributes_t attr = attributes(false);
+    size_t size = 0;
+    int status = cc3xx_generate_key(&attr, private_key, 32, &size);
+    return status ? status : (size == 32 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+
+int opensk_cc310_public(const uint8_t private_key[32], uint8_t public_key[64])
+{
+    psa_key_attributes_t attr = attributes(false);
+    uint8_t encoded[65];
+    size_t size = 0;
+    int status = cc3xx_export_public_key(&attr, private_key, 32, encoded, sizeof(encoded), &size);
+    if (status) {
+        return status;
+    }
+    if (size != 65 || encoded[0] != 4) {
+        return PSA_ERROR_CORRUPTION_DETECTED;
+    }
+    for (size_t i = 0; i < 64; i++) {
+        public_key[i] = encoded[i + 1];
+    }
+    return 0;
+}
+
+int opensk_cc310_validate_public(const uint8_t public_key[64])
+{
+    psa_key_attributes_t attr = attributes(true);
+    uint8_t encoded[65] = {4}, imported[65];
+    size_t size = 0, bits = 0;
+    for (size_t i = 0; i < 64; i++) {
+        encoded[i + 1] = public_key[i];
+    }
+    int status = cc3xx_import_key(&attr, encoded, sizeof(encoded), imported, sizeof(imported), &size, &bits);
+    return status ? status : (size == 65 && bits == 256 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+
+int opensk_cc310_sign(const uint8_t private_key[32], const uint8_t digest[32], uint8_t signature[64])
+{
+    psa_key_attributes_t attr = attributes(false);
+    size_t size = 0;
+    int status = cc3xx_sign_hash(&attr, private_key, 32, PSA_ALG_ECDSA(PSA_ALG_SHA_256),
+                                digest, 32, signature, 64, &size);
+    return status ? status : (size == 64 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+
+int opensk_cc310_verify(const uint8_t public_key[64], const uint8_t digest[32], const uint8_t signature[64])
+{
+    psa_key_attributes_t attr = attributes(true);
+    uint8_t encoded[65] = {4};
+    for (size_t i = 0; i < 64; i++) {
+        encoded[i + 1] = public_key[i];
+    }
+    return cc3xx_verify_hash(&attr, encoded, sizeof(encoded), PSA_ALG_ECDSA(PSA_ALG_SHA_256),
+                            digest, 32, signature, 64);
+}
+
+int opensk_cc310_shared(const uint8_t private_key[32], const uint8_t public_key[64], uint8_t shared[32])
+{
+    psa_key_attributes_t attr = attributes(false);
+    uint8_t encoded[65] = {4};
+    size_t size = 0;
+    for (size_t i = 0; i < 64; i++) {
+        encoded[i + 1] = public_key[i];
+    }
+    int status = cc3xx_key_agreement(&attr, private_key, 32, encoded, sizeof(encoded),
+                                    shared, 32, &size, PSA_ALG_ECDH);
+    return status ? status : (size == 32 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+
+/* The Nordic archive calls these PSA wrapper hooks from its internal hash
+ * paths. Use the pinned PSA operation layout and its CC3XX context directly. */
+int psa_driver_wrapper_hash_setup(psa_hash_operation_t *operation, psa_algorithm_t alg)
+{
+    int status = cc3xx_hash_setup(&operation->MBEDTLS_PRIVATE(ctx).cc3xx_driver_ctx, alg);
+    operation->MBEDTLS_PRIVATE(id) = status ? 0 : 1;
+    return status;
+}
+
+int psa_driver_wrapper_hash_update(psa_hash_operation_t *operation, const uint8_t *input, size_t size)
+{
+    return cc3xx_hash_update(&operation->MBEDTLS_PRIVATE(ctx).cc3xx_driver_ctx, input, size);
+}
+
+int psa_driver_wrapper_hash_finish(psa_hash_operation_t *operation, uint8_t *hash, size_t size, size_t *length)
+{
+    int status = cc3xx_hash_finish(&operation->MBEDTLS_PRIVATE(ctx).cc3xx_driver_ctx, hash, size, length);
+    operation->MBEDTLS_PRIVATE(id) = 0;
+    return status;
+}
+
+int psa_driver_wrapper_hash_compute(psa_algorithm_t alg, const uint8_t *input, size_t input_length,
+                                    uint8_t *hash, size_t hash_size, size_t *hash_length)
+{
+    return cc3xx_hash_compute(alg, input, input_length, hash, hash_size, hash_length);
+}
+
+_Static_assert(sizeof(cc3xx_hash_operation_t) == 60 * sizeof(uint32_t), "CC310 hash ABI");
+_Static_assert(sizeof(cc3xx_mac_operation_t) == 79 * sizeof(uint32_t), "CC310 MAC ABI");
+
+int opensk_cc310_hash_setup(cc3xx_hash_operation_t *operation)
+{
+    return cc3xx_hash_setup(operation, PSA_ALG_SHA_256);
+}
+int opensk_cc310_hash_update(cc3xx_hash_operation_t *operation, const uint8_t *data, size_t size)
+{
+    return cc3xx_hash_update(operation, data, size);
+}
+int opensk_cc310_hash_finish(cc3xx_hash_operation_t *operation, uint8_t output[32])
+{
+    size_t size = 0;
+    int status = cc3xx_hash_finish(operation, output, 32, &size);
+    return status ? status : (size == 32 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+int opensk_cc310_hash_abort(cc3xx_hash_operation_t *operation)
+{
+    return cc3xx_hash_abort(operation);
+}
+int opensk_cc310_hmac_setup(cc3xx_mac_operation_t *operation, const uint8_t key[64])
+{
+    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+    psa_set_key_type(&attr, PSA_KEY_TYPE_HMAC);
+    psa_set_key_bits(&attr, 512);
+    return cc3xx_mac_sign_setup(operation, &attr, key, 64, PSA_ALG_HMAC(PSA_ALG_SHA_256));
+}
+int opensk_cc310_hmac_update(cc3xx_mac_operation_t *operation, const uint8_t *data, size_t size)
+{
+    return cc3xx_mac_update(operation, data, size);
+}
+int opensk_cc310_hmac_finish(cc3xx_mac_operation_t *operation, uint8_t output[32])
+{
+    size_t size = 0;
+    int status = cc3xx_mac_sign_finish(operation, output, 32, &size);
+    return status ? status : (size == 32 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+int opensk_cc310_hmac_abort(cc3xx_mac_operation_t *operation)
+{
+    return cc3xx_mac_abort(operation);
+}
+
+static psa_key_attributes_t ed25519_attributes(bool public_key)
+{
+    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+    psa_set_key_type(&attr, public_key ? PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_TWISTED_EDWARDS)
+                                      : PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_TWISTED_EDWARDS));
+    psa_set_key_bits(&attr, 255);
+    return attr;
+}
+int opensk_cc310_ed25519_generate(uint8_t seed[32])
+{
+    psa_key_attributes_t attr = ed25519_attributes(false);
+    size_t size = 0;
+    int status = cc3xx_generate_key(&attr, seed, 32, &size);
+    return status ? status : (size == 32 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+int opensk_cc310_ed25519_public(const uint8_t seed[32], uint8_t public_key[32])
+{
+    psa_key_attributes_t attr = ed25519_attributes(false);
+    size_t size = 0;
+    int status = cc3xx_export_public_key(&attr, seed, 32, public_key, 32, &size);
+    return status ? status : (size == 32 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+int opensk_cc310_ed25519_sign(const uint8_t seed[32], const uint8_t *message, size_t message_size,
+                             uint8_t signature[64])
+{
+    psa_key_attributes_t attr = ed25519_attributes(false);
+    size_t size = 0;
+    int status = cc3xx_sign_message(&attr, seed, 32, PSA_ALG_PURE_EDDSA,
+                                    message, message_size, signature, 64, &size);
+    return status ? status : (size == 64 ? 0 : PSA_ERROR_CORRUPTION_DETECTED);
+}
+int opensk_cc310_ed25519_verify(const uint8_t public_key[32], const uint8_t *message,
+                               size_t message_size, const uint8_t signature[64])
+{
+    psa_key_attributes_t attr = ed25519_attributes(true);
+    return cc3xx_verify_message(&attr, public_key, 32, PSA_ALG_PURE_EDDSA,
+                                message, message_size, signature, 64);
+}
