+        stage = next;
+        log::debug!("CC310 self-test stage {}", next);
+        color(if next < 8 { next } else { 7 });
+    });
+    log::debug!("CC310 self-test: stage={} result={:?}", stage, result);
+    loop {
+        // Green blinking: all checks passed. Red bursts count the failed stage.
+        let (count, code) = if result.is_ok() { (1, 2) } else { (stage, 1) };
+        for _ in 0 .. count {
+            color(code);
+            cortex_m::asm::delay(8_000_000);
+            color(0);
+            cortex_m::asm::delay(8_000_000);
+        }
+        cortex_m::asm::delay(32_000_000);
+    }
+}
