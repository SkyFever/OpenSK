+// SPDX-License-Identifier: Apache-2.0
+//! Host-only RustCrypto model. It never links into the ARM firmware.
+use alloc::boxed::Box;
+
+use hmac::Mac;
+use sha2::Digest;
+
+unsafe fn load<T>(state: *mut u32) -> *mut T {
+    // SAFETY: Model state was initialized with store() and has room for one pointer.
+    unsafe { state.cast::<*mut T>().read_unaligned() }
+}
+unsafe fn store<T>(state: *mut u32, value: *mut T) {
+    // SAFETY: Each published operation layout has room for one pointer; alignment is unrestricted.
+    unsafe { state.cast::<*mut T>().write_unaligned(value) };
+}
+unsafe fn free<T>(state: *mut u32) {
+    let ptr = unsafe { load::<T>(state) };
+    if !ptr.is_null() {
+        unsafe {
+            drop(Box::from_raw(ptr));
+            store::<T>(state, core::ptr::null_mut())
+        };
+    }
+}
+
+pub unsafe fn opensk_cc310_hash_setup(state: *mut u32) -> i32 {
+    unsafe { store(state, Box::into_raw(Box::new(sha2::Sha256::new()))) };
+    0
+}
+pub unsafe fn opensk_cc310_hash_update(state: *mut u32, data: *const u8, size: usize) -> i32 {
+    unsafe { (&mut *load::<sha2::Sha256>(state)).update(core::slice::from_raw_parts(data, size)) };
+    0
+}
+pub unsafe fn opensk_cc310_hash_finish(state: *mut u32, output: *mut u8) -> i32 {
+    let value = unsafe { (&*load::<sha2::Sha256>(state)).clone().finalize() };
+    unsafe { core::ptr::copy_nonoverlapping(value.as_ptr(), output, 32) };
+    0
+}
+pub unsafe fn opensk_cc310_hash_abort(state: *mut u32) -> i32 {
+    unsafe { free::<sha2::Sha256>(state) };
+    0
+}
+pub unsafe fn opensk_cc310_hmac_setup(state: *mut u32, key: *const u8) -> i32 {
+    let key = unsafe { core::slice::from_raw_parts(key, 64) };
+    let value = hmac::Hmac::<sha2::Sha256>::new_from_slice(key).unwrap();
+    unsafe { store(state, Box::into_raw(Box::new(value))) };
+    0
+}
+pub unsafe fn opensk_cc310_hmac_update(state: *mut u32, data: *const u8, size: usize) -> i32 {
+    unsafe {
+        (&mut *load::<hmac::Hmac<sha2::Sha256>>(state))
+            .update(core::slice::from_raw_parts(data, size))
+    };
+    0
+}
+pub unsafe fn opensk_cc310_hmac_finish(state: *mut u32, output: *mut u8) -> i32 {
+    let value =
+        unsafe { (&*load::<hmac::Hmac<sha2::Sha256>>(state)).clone().finalize().into_bytes() };
+    unsafe { core::ptr::copy_nonoverlapping(value.as_ptr(), output, 32) };
+    0
+}
+pub unsafe fn opensk_cc310_hmac_abort(state: *mut u32) -> i32 {
+    unsafe { free::<hmac::Hmac<sha2::Sha256>>(state) };
+    0
+}
