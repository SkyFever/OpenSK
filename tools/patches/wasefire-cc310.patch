+#[cfg(feature = "ecc")]
+#[test]
+fn additional_ecc_curves_sign_verify_and_ecdh() {
+    use ecc::{self, Curve};
+    let _test = TEST.lock().unwrap();
+    for curve in [
+        Curve::P192,
+        Curve::P224,
+        Curve::P256,
+        Curve::P384,
+        Curve::Secp192k1,
+        Curve::Secp224k1,
+        Curve::Secp256k1,
+        Curve::BrainpoolP256r1,
+    ] {
+        let size = curve.scalar_size();
+        let mut key = alloc::vec![0;size];
+        key[size - 1] = 1;
+        let mut public = alloc::vec![0;curve.public_size()];
+        ecc::public(curve, &key, &mut public).unwrap();
+        let mut sig = alloc::vec![0;2*size];
+        ecc::sign(curve, &key, &[0x42; 32], &mut sig).unwrap();
+        assert!(ecc::verify(curve, &public, &[0x42; 32], &sig).unwrap());
+        assert!(!ecc::verify(curve, &public, &[0x43; 32], &sig).unwrap());
+        let mut shared = alloc::vec![0;size];
+        ecc::shared(curve, &key, &public, &mut shared).unwrap();
+        assert_eq!(&shared, &public[1 .. 1 + size]);
+        shared.fill(0xa5);
+        public[0] = 0;
+        assert!(ecc::shared(curve, &key, &public, &mut shared).is_err());
+        assert_eq!(shared, alloc::vec![0xa5;size]);
+    }
