+    ) -> Result<(), Error> {
+        length(private, 32)?;
+        let mut signature = Zeroizing::new([0; 64]);
+        // SAFETY: All buffers remain alive throughout the synchronous driver call.
+        driver(|| unsafe {
+            ffi::opensk_cc310_ed25519_sign(
+                private.as_ptr(),
+                message.as_ptr(),
+                message.len(),
+                signature.as_mut_ptr(),
+            )
+        })?;
+        r.copy_from_slice(&signature[.. 32]);
+        s.copy_from_slice(&signature[32 ..]);
+        Ok(())
+    }
+    fn verify(public: &[u8], message: &[u8], r: &[u8; 32], s: &[u8; 32]) -> Result<bool, Error> {
+        length(public, 32)?;
+        let mut signature = [0; 64];
+        signature[.. 32].copy_from_slice(r);
+        signature[32 ..].copy_from_slice(s);
+        let mut valid = true;
+        driver(|| {
+            // SAFETY: Every buffer has the exact length required by the C shim.
+            let result = unsafe {
+                ffi::opensk_cc310_ed25519_verify(
+                    public.as_ptr(),
+                    message.as_ptr(),
+                    message.len(),
+                    signature.as_ptr(),
+                )
+            };
+            if result == INVALID_SIGNATURE {
+                valid = false;
+                0
+            } else {
+                result
+            }
+        })?;
+        Ok(valid)
+    }
+    fn drop_private(private: &mut [u8]) -> Result<(), Error> {
+        length(private, 32)?;
+        private.zeroize();
+        Ok(())
+    }
+    fn export_private(private: &[u8], wrapped: &mut [u8]) -> Result<(), Error> {
+        length(private, 32)?;
+        length(wrapped, 32)?;
+        wrapped.copy_from_slice(private);
+        Ok(())
+    }
+    fn import_private(wrapped: &[u8], private: &mut [u8]) -> Result<(), Error> {
+        length(wrapped, 32)?;
+        length(private, 32)?;
+        private.copy_from_slice(wrapped);
+        Ok(())
+    }
+    fn export_public(public: &[u8], a: &mut [u8; 32]) -> Result<(), Error> {
+        length(public, 32)?;
+        a.copy_from_slice(public);
+        Ok(())
+    }
+    fn import_public(a: &[u8; 32], public: &mut [u8]) -> Result<(), Error> {
+        length(public, 32)?;
+        public.copy_from_slice(a);
+        Ok(())
+    }
+}
