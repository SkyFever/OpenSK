+    let y = hex::<32>("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5");
+    let mut generated = [0; 32];
+    <Impl as ecdsa::Api<32>>::generate(&mut generated).unwrap();
+    assert!(private(&generated).is_ok());
+    let mut public = [0; 64];
+    <Impl as ecdh::Api<32>>::public(&key(1), &mut public).unwrap();
+    assert_eq!(&public[.. 32], &x);
+    assert_eq!(&public[32 ..], &y);
