+// SPDX-License-Identifier: Apache-2.0
+//! RSA with PKCS#1 DER keys, PKCS#1 v1.5/PSS signatures and v1.5/OAEP encryption.
+use alloc::vec;
+use alloc::vec::Vec;
+
+use wasefire_board_api::Error;
+use zeroize::{Zeroize, Zeroizing};
+
+use crate::{INVALID_SIGNATURE, driver, length};
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub enum Bits {
+    B1024 = 1024,
+    B1536 = 1536,
+    B2048 = 2048,
+}
+impl Bits {
+    pub const fn size(self) -> usize {
+        self as usize / 8
+    }
+}
+#[derive(Clone, Copy)]
+pub enum SignaturePadding {
+    Pkcs1v15,
+    Pss,
+}
+#[derive(Clone, Copy)]
+pub enum EncryptionPadding {
+    Pkcs1v15,
+    OaepSha256,
+}
+fn key(value: &[u8]) -> Result<(), Error> {
+    if value.is_empty() || value.len() > 1536 { Err(Error::user(0)) } else { Ok(()) }
+}
+pub fn generate(bits: Bits) -> Result<Zeroizing<Vec<u8>>, Error> {
+    let mut value = Zeroizing::new(vec![0; 1536]);
+    let mut written = 0;
+    // SAFETY: A bounded DER buffer and live length pointer are supplied.
+    driver(|| unsafe {
+        ffi::opensk_cc310_rsa_generate(bits as usize, value.as_mut_ptr(), value.len(), &mut written)
+    })?;
+    if written == 0 || written > value.len() {
+        return Err(Error::world(0));
+    }
+    value[written ..].zeroize();
+    value.truncate(written);
+    Ok(value)
+}
+pub fn public(bits: Bits, private: &[u8]) -> Result<Vec<u8>, Error> {
+    key(private)?;
+    let mut value = vec![0; 512];
+    let mut written = 0;
+    // SAFETY: The DER input and public buffer remain alive through the call.
+    driver(|| unsafe {
+        ffi::opensk_cc310_rsa_public(
+            bits as usize,
+            private.as_ptr(),
+            private.len(),
+            value.as_mut_ptr(),
+            value.len(),
+            &mut written,
+        )
+    })?;
+    if written == 0 || written > value.len() {
+        return Err(Error::world(0));
+    }
+    value[written ..].zeroize();
+    value.truncate(written);
+    Ok(value)
+}
+pub fn sign(
+    bits: Bits, padding: SignaturePadding, private: &[u8], digest: &[u8; 32], output: &mut [u8],
+) -> Result<(), Error> {
+    key(private)?;
+    length(output, bits.size())?;
+    let mut value = Zeroizing::new(vec![0; output.len()]);
+    // SAFETY: DER input, SHA-256 digest and modulus-sized signature are valid buffers.
+    driver(|| unsafe {
+        ffi::opensk_cc310_rsa_sign(
+            bits as usize,
+            matches!(padding, SignaturePadding::Pss),
+            private.as_ptr(),
+            private.len(),
+            digest.as_ptr(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+pub fn verify(
+    bits: Bits, padding: SignaturePadding, public: &[u8], digest: &[u8; 32], signature: &[u8],
+) -> Result<bool, Error> {
+    key(public)?;
+    length(signature, bits.size())?;
+    let mut valid = true;
+    driver(|| {
+        // SAFETY: DER input, digest and signature lengths were checked.
+        let result = unsafe {
+            ffi::opensk_cc310_rsa_verify(
+                bits as usize,
+                matches!(padding, SignaturePadding::Pss),
+                public.as_ptr(),
+                public.len(),
+                digest.as_ptr(),
+                signature.as_ptr(),
+                signature.len(),
+            )
+        };
+        if result == INVALID_SIGNATURE {
+            valid = false;
+            0
+        } else {
+            result
+        }
+    })?;
+    Ok(valid)
+}
+pub fn encrypt(
+    bits: Bits, padding: EncryptionPadding, public: &[u8], label: &[u8], input: &[u8],
+    output: &mut [u8],
+) -> Result<(), Error> {
+    key(public)?;
+    length(output, bits.size())?;
+    let oaep = matches!(padding, EncryptionPadding::OaepSha256);
+    if (!oaep && !label.is_empty()) || input.len() > bits.size() - if oaep { 66 } else { 11 } {
+        return Err(Error::user(0));
+    }
+    let mut value = Zeroizing::new(vec![0; output.len()]);
+    let mut written = 0;
+    // SAFETY: Sized modulus output and bounded plaintext/label stay valid through the call.
+    driver(|| unsafe {
+        ffi::opensk_cc310_rsa_crypt(
+            bits as usize,
+            true,
+            oaep,
+            public.as_ptr(),
+            public.len(),
+            label.as_ptr(),
+            label.len(),
+            input.as_ptr(),
+            input.len(),
+            value.as_mut_ptr(),
+            value.len(),
+            &mut written,
+        )
+    })?;
+    if written != value.len() {
+        return Err(Error::world(0));
+    }
+    output.copy_from_slice(&value);
+    Ok(())
+}
+pub fn decrypt(
+    bits: Bits, padding: EncryptionPadding, private: &[u8], label: &[u8], input: &[u8],
+) -> Result<Zeroizing<Vec<u8>>, Error> {
+    key(private)?;
+    length(input, bits.size())?;
+    let oaep = matches!(padding, EncryptionPadding::OaepSha256);
+    if !oaep && !label.is_empty() {
+        return Err(Error::user(0));
+    }
+    let mut value = Zeroizing::new(vec![0; bits.size()]);
+    let mut written = 0;
+    // SAFETY: Ciphertext is modulus-sized; unverified plaintext remains in a wiped temporary.
+    driver(|| unsafe {
+        ffi::opensk_cc310_rsa_crypt(
+            bits as usize,
+            false,
+            oaep,
+            private.as_ptr(),
+            private.len(),
+            label.as_ptr(),
+            label.len(),
+            input.as_ptr(),
+            input.len(),
+            value.as_mut_ptr(),
+            value.len(),
+            &mut written,
+        )
+    })?;
+    if written > value.len() {
+        return Err(Error::world(0));
+    }
+    value[written ..].zeroize();
+    value.truncate(written);
+    Ok(value)
+}
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_rsa_generate(
+            bits: usize, output: *mut u8, size: usize, written: *mut usize,
+        ) -> i32;
+        pub fn opensk_cc310_rsa_public(
+            bits: usize, key: *const u8, key_size: usize, output: *mut u8, size: usize,
+            written: *mut usize,
+        ) -> i32;
+        pub fn opensk_cc310_rsa_sign(
+            bits: usize, pss: bool, key: *const u8, key_size: usize, digest: *const u8,
+            output: *mut u8, size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_rsa_verify(
+            bits: usize, pss: bool, key: *const u8, key_size: usize, digest: *const u8,
+            sig: *const u8, size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_rsa_crypt(
+            bits: usize, encrypt: bool, oaep: bool, key: *const u8, key_size: usize,
+            label: *const u8, label_size: usize, input: *const u8, input_size: usize,
+            output: *mut u8, capacity: usize, written: *mut usize,
+        ) -> i32;
+    }
+}
+#[cfg(test)]
+#[path = "rsa_model.rs"]
+mod ffi;
