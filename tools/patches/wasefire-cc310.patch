+/* Independent, process-lifetime DRBG. Rust's global guard also covers calls
+ * made by Nordic key generation via psa_generate_random. */
+static nrf_cc3xx_platform_ctr_drbg_context_t opensk_random_context;
+int opensk_cc310_random(uint8_t *output, size_t size)
+{
+    if (!opensk_random_context.is_initialized) {
+        static const uint8_t personalization[] = "OpenSK nRF52840 CC310";
+        int result = nrf_cc3xx_platform_ctr_drbg_init(&opensk_random_context,
+                                                     personalization, sizeof(personalization) - 1);
+        if (result) {
+            nrf_cc3xx_platform_ctr_drbg_free(&opensk_random_context);
+            return PSA_ERROR_INSUFFICIENT_ENTROPY;
+        }
+    }
+    while (size) {
+        size_t chunk = size > 256 ? 256 : size, written = 0;
+        int result = nrf_cc3xx_platform_ctr_drbg_get(&opensk_random_context, output, chunk, &written);
+        if (result || written != chunk) {
+            return PSA_ERROR_INSUFFICIENT_ENTROPY;
+        }
+        output += chunk;
+        size -= chunk;
+    }
+    return 0;
+}
+int opensk_cc310_entropy(uint8_t *output, size_t size)
+{
+    while (size) {
+        size_t chunk = size > 32 ? 32 : size, estimate = 0;
+        int result = cc3xx_get_entropy(0, &estimate, output, chunk);
+        if (result) {
+            return result;
+        }
+        if (!estimate || estimate % 8 || estimate / 8 > chunk) {
+            return PSA_ERROR_INSUFFICIENT_ENTROPY;
+        }
+        output += estimate / 8;
+        size -= estimate / 8;
+    }
+    return 0;
+}
