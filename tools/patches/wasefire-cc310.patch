+// SPDX-License-Identifier: Apache-2.0
+//! CryptoCell TRNG and TRNG-seeded AES CTR-DRBG. Errors wipe the whole output.
+use wasefire_board_api::Error;
+use zeroize::Zeroize;
+
+use crate::driver;
+
+/// Fills bytes using Nordic's hardware-assisted, automatically reseeded CTR-DRBG.
+pub fn fill_random(output: &mut [u8]) -> Result<(), Error> {
+    if output.is_empty() {
+        return Ok(());
+    }
+    // SAFETY: The driver is serialized and receives a live writable slice.
+    let result = driver(|| unsafe { ffi::opensk_cc310_random(output.as_mut_ptr(), output.len()) });
+    if result.is_err() {
+        output.zeroize();
+    }
+    result
+}
+
+/// Collects entropy directly from the CryptoCell TRNG.
+pub fn fill_entropy(output: &mut [u8]) -> Result<(), Error> {
+    if output.is_empty() {
+        return Ok(());
+    }
+    // SAFETY: The driver is serialized and receives a live writable slice.
+    let result = driver(|| unsafe { ffi::opensk_cc310_entropy(output.as_mut_ptr(), output.len()) });
+    if result.is_err() {
+        output.zeroize();
+    }
+    result
+}
+
+// Nordic keygen can request bytes while driver() already owns the global guard.
+// Re-entering fill_random() here would fail; call the C shim under that guard.
+/// Supplies Nordic's nested PSA random requests.
+///
+/// # Safety
+/// The caller must own the CC310 guard and provide size writable bytes.
+#[cfg(not(test))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psa_generate_random(output: *mut u8, size: usize) -> i32 {
+    if size == 0 {
+        return 0;
+    }
+    if output.is_null() || size > isize::MAX as usize {
+        return -135;
+    }
+    // SAFETY: This is a synchronous Nordic callback under the owning guard.
+    let result = unsafe { ffi::opensk_cc310_random(output, size) };
+    if result != 0 {
+        // SAFETY: The caller provides size writable bytes.
+        unsafe { core::slice::from_raw_parts_mut(output, size) }.zeroize();
+    }
+    result
+}
+
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_random(output: *mut u8, size: usize) -> i32;
+        pub fn opensk_cc310_entropy(output: *mut u8, size: usize) -> i32;
+    }
+}
+#[cfg(test)]
+pub(crate) mod ffi {
+    use core::sync::atomic::{AtomicI32, Ordering};
+    pub static ERROR: AtomicI32 = AtomicI32::new(0);
+    pub unsafe fn opensk_cc310_random(output: *mut u8, size: usize) -> i32 {
+        unsafe { core::ptr::write_bytes(output, 0x42, size) };
+        ERROR.swap(0, Ordering::Relaxed)
+    }
+    pub unsafe fn opensk_cc310_entropy(output: *mut u8, size: usize) -> i32 {
+        unsafe { opensk_cc310_random(output, size) }
+    }
+}
