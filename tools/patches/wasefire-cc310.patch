+/* The legacy SRP driver expects the Mbed TLS 2.x three-pointer MD ABI.
+ * It passes the opaque MD info back to these hooks without dereferencing it.
+ * Only SHA256 is enabled by this SRP adapter; all hashing remains CC310-backed.
+ * Keep these hooks separate from the newer PSA operation/context ABI. */
+typedef mbedtls_md_context_t opensk_legacy_md_context;
+/* The current header exposes the same first two pointer fields. These hooks
+ * never touch the legacy third (HMAC) pointer, since HMAC is disabled. */
+_Static_assert(sizeof(opensk_legacy_md_context) == 8, "MD prefix ABI");
+_Static_assert(offsetof(opensk_legacy_md_context, MBEDTLS_PRIVATE(md_ctx)) == 4, "MD state ABI");
+/* Opaque identity token. The legacy SRP object never reads its fields. */
+struct mbedtls_md_info_t { uint32_t marker; };
+static const mbedtls_md_info_t opensk_legacy_sha256_info = {0x256};
+extern void *mbedtls_calloc(size_t count, size_t size);
+extern void mbedtls_free(void *pointer);
+const mbedtls_md_info_t *mbedtls_md_info_from_string(const char *name)
+{
+    static const char expected[] = "SHA256";
+    for (size_t i = 0; i < sizeof(expected); i++) {
+        if (name[i] != expected[i]) return NULL;
+    }
+    return &opensk_legacy_sha256_info;
+}
+void mbedtls_md_init(opensk_legacy_md_context *ctx)
+{
+    *ctx = (opensk_legacy_md_context){0};
+}
+int mbedtls_md_setup(opensk_legacy_md_context *ctx, const mbedtls_md_info_t *info, int hmac)
+{
+    if (info != &opensk_legacy_sha256_info || hmac) return -0x5100;
+    ctx->MBEDTLS_PRIVATE(md_ctx) = mbedtls_calloc(1, sizeof(cc3xx_hash_operation_t));
+    if (!ctx->MBEDTLS_PRIVATE(md_ctx)) return -0x5180;
+    ctx->MBEDTLS_PRIVATE(md_info) = info;
+    return 0;
+}
+int mbedtls_md_starts(opensk_legacy_md_context *ctx)
+{
+    return cc3xx_hash_setup(ctx->MBEDTLS_PRIVATE(md_ctx), PSA_ALG_SHA_256);
+}
+int mbedtls_md_update(opensk_legacy_md_context *ctx, const uint8_t *input, size_t size)
+{
+    return cc3xx_hash_update(ctx->MBEDTLS_PRIVATE(md_ctx), input, size);
+}
+int mbedtls_md_finish(opensk_legacy_md_context *ctx, uint8_t *output)
+{
+    size_t written = 0;
+    int result = cc3xx_hash_finish(ctx->MBEDTLS_PRIVATE(md_ctx), output, 32, &written);
+    return result ? result : (written == 32 ? 0 : -0x5100);
+}
+void mbedtls_md_free(opensk_legacy_md_context *ctx)
+{
+    if (ctx->MBEDTLS_PRIVATE(md_ctx)) {
+        cc3xx_hash_abort(ctx->MBEDTLS_PRIVATE(md_ctx));
+        mbedtls_free(ctx->MBEDTLS_PRIVATE(md_ctx));
+    }
+    *ctx = (opensk_legacy_md_context){0};
+}
+int mbedtls_md(const mbedtls_md_info_t *info, const uint8_t *input, size_t size, uint8_t *output)
+{
+    if (info != &opensk_legacy_sha256_info) return -0x5100;
+    size_t written = 0;
+    int result = cc3xx_hash_compute(PSA_ALG_SHA_256, input, size, output, 32, &written);
+    return result ? result : (written == 32 ? 0 : -0x5100);
+}
+#include <mbedtls_extra/mbedtls_cc_srp.h>
+_Static_assert(sizeof(mbedtls_srp_context) == 1020, "SRP legacy ABI");
+_Static_assert(offsetof(mbedtls_srp_context, hashMode) == 424, "SRP hash ABI");
+_Static_assert(offsetof(mbedtls_srp_context, pRndCtx) == 436, "SRP RNG ABI");
+_Static_assert(_Alignof(mbedtls_srp_context) <= _Alignof(uint32_t), "SRP alignment");
+_Static_assert(sizeof(mbedtls_srp_context) % sizeof(uint32_t) == 0, "SRP size");
+static int opensk_srp_random(void *state, unsigned char *output, size_t size)
+{
+    (void)state;
+    return opensk_cc310_random(output, size);
+}
+static CCRndContext_t opensk_srp_random_context = {
+    .rndState = NULL, .entropyCtx = NULL, .rndGenerateVectFunc = opensk_srp_random
+};
+size_t opensk_cc310_srp_size(void) { return sizeof(mbedtls_srp_context); }
+size_t opensk_cc310_srp_key_size(const mbedtls_srp_context *ctx) { return ctx->sessionKeySize; }
+int opensk_cc310_srp_init(mbedtls_srp_context *ctx, bool host, uint8_t *modulus,
+                          size_t size, uint8_t generator, uint8_t *user,
+                          size_t user_size, uint8_t *password, size_t password_size)
+{
+    return mbedtls_srp_init(host ? CC_SRP_HOST : CC_SRP_USER, CC_SRP_VER_6A,
+                            modulus, generator, size * 8, CC_HASH_SHA256_mode,
+                            user, user_size, password, password_size,
+                            &opensk_srp_random_context, ctx);
+}
+int opensk_cc310_srp_verifier(mbedtls_srp_context *ctx, uint8_t *salt, size_t salt_size,
+                              uint8_t *verifier)
+{
+    return mbedtls_srp_pwd_ver_create(salt_size, salt, verifier, ctx);
+}
+int opensk_cc310_srp_public(mbedtls_srp_context *ctx, bool host, uint8_t *verifier, uint8_t *output)
+{
+    return host ? mbedtls_srp_host_pub_key_create(32, verifier, output, ctx)
+                : mbedtls_srp_user_pub_key_create(32, output, ctx);
+}
+int opensk_cc310_srp_user_proof(mbedtls_srp_context *ctx, uint8_t *salt, size_t salt_size,
+                                uint8_t *a, uint8_t *b, uint8_t *proof, uint8_t *key)
+{
+    return mbedtls_srp_user_proof_calc(salt_size, salt, a, b, proof, key, ctx);
+}
+int opensk_cc310_srp_host_proof(mbedtls_srp_context *ctx, uint8_t *salt, size_t salt_size,
+                                uint8_t *verifier, uint8_t *a, uint8_t *b, uint8_t *user_proof,
+                                uint8_t *proof, uint8_t *key)
+{
+    return mbedtls_srp_host_proof_verify_and_calc(salt_size, salt, verifier, a, b, user_proof, proof, key, ctx);
+}
+int opensk_cc310_srp_user_verify(mbedtls_srp_context *ctx, uint8_t *key, uint8_t *a,
+                                 uint8_t *user_proof, uint8_t *host_proof)
+{
+    return mbedtls_srp_user_proof_verify(key, a, user_proof, host_proof, ctx);
+}
+#endif
