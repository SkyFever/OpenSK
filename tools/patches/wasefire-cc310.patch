+    let (mut r, mut s) = ([0; 32], [0; 32]);
+    Ed25519::sign(&seed, &[0x72], &mut r, &mut s).unwrap();
+    assert_eq!(&r, &expected[.. 32]);
+    assert_eq!(&s, &expected[32 ..]);
+    ffi::INIT_ERROR.store(-147, Ordering::Relaxed);
+    let mut public = [0xa5; 32];
+    assert!(Ed25519::public(&seed, &mut public).is_err());
+    assert_eq!(public, [0xa5; 32]);
+    assert!(!BUSY.load(Ordering::Relaxed));
+    Ed25519::public(&seed, &mut public).unwrap();
+}
