+    let (mut ab, mut ba) = ([0; 32], [0; 32]);
+    <Impl as ecdh::Api<32>>::shared(&key(3), &b, &mut ab).unwrap();
+    <Impl as ecdh::Api<32>>::shared(&key(11), &a, &mut ba).unwrap();
