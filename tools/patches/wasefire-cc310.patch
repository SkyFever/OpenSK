+// SPDX-License-Identifier: Apache-2.0
+//! Additional CC310 hash/HMAC primitives. OpenSK continues to use streaming SHA-256.
+use wasefire_board_api::Error;
+use zeroize::Zeroizing;
+
+use crate::{driver, length};
+
+#[derive(Clone, Copy)]
+#[repr(u32)]
+pub enum Algorithm {
+    Sha1,
+    Sha224,
+    Sha256,
+}
+impl Algorithm {
+    pub const fn output_size(self) -> usize {
+        match self {
+            Self::Sha1 => 20,
+            Self::Sha224 => 28,
+            Self::Sha256 => 32,
+        }
+    }
+}
+pub fn hash(algorithm: Algorithm, data: &[u8], output: &mut [u8]) -> Result<(), Error> {
+    length(output, algorithm.output_size())?;
+    let mut value = Zeroizing::new([0; 32]);
+    // SAFETY: Input/output slices remain alive throughout the serialized call.
+    driver(|| unsafe {
+        ffi::opensk_cc310_hash_compute(
+            algorithm as u32,
+            data.as_ptr(),
+            data.len(),
+            value.as_mut_ptr(),
+            output.len(),
+        )
+    })?;
+    output.copy_from_slice(&value[.. output.len()]);
+    Ok(())
+}
+pub fn hmac(algorithm: Algorithm, key: &[u8], data: &[u8], output: &mut [u8]) -> Result<(), Error> {
+    length(output, algorithm.output_size())?;
+    let mut normalized = Zeroizing::new([0; 64]);
+    if key.len() > 64 {
+        hash(algorithm, key, &mut normalized[.. algorithm.output_size()])?;
+    } else {
+        normalized[.. key.len()].copy_from_slice(key);
+    }
+    let mut value = Zeroizing::new([0; 32]);
+    // SAFETY: A 64-byte normalized HMAC key and sized input/output buffers are supplied.
+    driver(|| unsafe {
+        ffi::opensk_cc310_hmac_compute(
+            algorithm as u32,
+            normalized.as_ptr(),
+            data.as_ptr(),
+            data.len(),
+            value.as_mut_ptr(),
+            output.len(),
+        )
+    })?;
+    output.copy_from_slice(&value[.. output.len()]);
+    Ok(())
+}
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_hash_compute(
+            algorithm: u32, data: *const u8, size: usize, output: *mut u8, output_size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_hmac_compute(
+            algorithm: u32, key: *const u8, data: *const u8, size: usize, output: *mut u8,
+            output_size: usize,
+        ) -> i32;
+    }
+}
+#[cfg(test)]
+mod ffi {
+    use sha2::Digest;
+    pub unsafe fn opensk_cc310_hash_compute(
+        algorithm: u32, data: *const u8, size: usize, output: *mut u8, output_size: usize,
+    ) -> i32 {
+        let data = unsafe { core::slice::from_raw_parts(data, size) };
+        let output = unsafe { core::slice::from_raw_parts_mut(output, output_size) };
+        match algorithm {
+            0 => output.copy_from_slice(&sha1::Sha1::digest(data)),
+            1 => output.copy_from_slice(&sha2::Sha224::digest(data)),
+            2 => output.copy_from_slice(&sha2::Sha256::digest(data)),
+            _ => return -134,
+        }
+        0
+    }
+    pub unsafe fn opensk_cc310_hmac_compute(
+        algorithm: u32, key: *const u8, data: *const u8, size: usize, output: *mut u8,
+        output_size: usize,
+    ) -> i32 {
+        use hmac::Mac;
+        let key = unsafe { core::slice::from_raw_parts(key, 64) };
+        let data = unsafe { core::slice::from_raw_parts(data, size) };
+        let output = unsafe { core::slice::from_raw_parts_mut(output, output_size) };
+        macro_rules! mac {
+            ($hash:ty) => {{
+                let mut value = hmac::Hmac::<$hash>::new_from_slice(key).unwrap();
+                value.update(data);
+                output.copy_from_slice(&value.finalize().into_bytes());
+            }};
+        }
+        match algorithm {
+            0 => mac!(sha1::Sha1),
+            1 => mac!(sha2::Sha224),
+            2 => mac!(sha2::Sha256),
+            _ => return -134,
+        }
+        0
+    }
+}
