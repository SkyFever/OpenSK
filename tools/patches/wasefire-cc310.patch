+#[cfg(feature = "rsa")]
+#[test]
+fn rsa2048_pkcs1_pss_oaep_and_invalid_signature() {
+    use rsa::{self, Bits, EncryptionPadding, SignaturePadding};
+    let _test = TEST.lock().unwrap();
+    let bits = Bits::B2048;
+    let private = rsa::generate(bits).unwrap();
+    let public = rsa::public(bits, &private).unwrap();
+    for padding in [SignaturePadding::Pkcs1v15, SignaturePadding::Pss] {
+        let mut signature = [0; 256];
+        rsa::sign(bits, padding, &private, &[0x42; 32], &mut signature).unwrap();
+        assert!(rsa::verify(bits, padding, &public, &[0x42; 32], &signature).unwrap());
+        assert!(!rsa::verify(bits, padding, &public, &[0x43; 32], &signature).unwrap());
+        signature[0] ^= 1;
+        assert!(!rsa::verify(bits, padding, &public, &[0x42; 32], &signature).unwrap());
+    }
+    for (padding, label) in [
+        (EncryptionPadding::Pkcs1v15, b"".as_slice()),
+        (EncryptionPadding::OaepSha256, b"label".as_slice()),
+    ] {
+        let mut ciphertext = [0; 256];
+        rsa::encrypt(bits, padding, &public, label, b"OpenSK RSA", &mut ciphertext).unwrap();
+        let clear = rsa::decrypt(bits, padding, &private, label, &ciphertext).unwrap();
+        assert_eq!(clear.as_slice(), b"OpenSK RSA");
+        ciphertext[0] ^= 1;
+        let changed = rsa::decrypt(bits, padding, &private, label, &ciphertext);
+        match padding {
+            EncryptionPadding::OaepSha256 => assert!(changed.is_err()),
+            EncryptionPadding::Pkcs1v15 => {
+                // OpenSSL 3.2+ may return random plaintext for invalid v1.5 padding.
+                if let Ok(value) = changed {
+                    assert_ne!(value.as_slice(), b"OpenSK RSA");
+                }
+            }
+        }
+    }
+    assert!(rsa::public(bits, b"invalid DER").is_err());
+}
