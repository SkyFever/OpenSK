+fn aes128_nist_modes_mac_and_ccm_rejects_tampering() {
+    use aes128::*;
+    let _test = TEST.lock().unwrap();
+    let key = hex::<16>("2b7e151628aed2a6abf7158809cf4f3c");
+    let data = hex::<32>("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51");
+    for (mode, iv, expected) in [
+        (Mode::Ecb, [0; 16], "3ad77bb40d7a3660a89ecaf32466ef97f5d3d58503b9699de785895a96fdbaaf"),
+        (
+            Mode::Cbc,
+            hex("000102030405060708090a0b0c0d0e0f"),
+            "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b2",
+        ),
+        (
+            Mode::Ctr,
+            hex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"),
+            "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff",
+        ),
+    ] {
+        let mut out = [0; 32];
+        cipher(mode, true, &key, &iv, &data, &mut out).unwrap();
+        assert_eq!(out, hex::<32>(expected));
+        let mut clear = [0; 32];
+        cipher(mode, false, &key, &iv, &out, &mut clear).unwrap();
+        assert_eq!(clear, data);
+    }
+    let mut mac = [0; 16];
+    cmac(&key, b"", &mut mac).unwrap();
+    assert_eq!(mac, hex("bb1d6929e95937287fa37d129b756746"));
+    cbc_mac(&key, &data[.. 16], &mut mac).unwrap();
+    assert_eq!(mac, hex("3ad77bb40d7a3660a89ecaf32466ef97"));
+    let nonce = [0x11; 13];
+    let mut out = [0; 32];
+    let mut tag = [0; 8];
+    ccm_encrypt(&key, &nonce, b"aad", &data, &mut out, &mut tag).unwrap();
+    let mut clear = [0xa5; 32];
+    ccm_decrypt(&key, &nonce, b"aad", &out, &tag, &mut clear).unwrap();
+    assert_eq!(clear, data);
+    tag[0] ^= 1;
+    clear.fill(0xa5);
+    assert!(ccm_decrypt(&key, &nonce, b"aad", &out, &tag, &mut clear).is_err());
+    assert_eq!(clear, [0xa5; 32]);
+    assert!(ccm_encrypt(&key, &[0; 6], b"", &data, &mut out, &mut tag).is_err());
+    assert!(cipher(Mode::Cbc, true, &key, &[0; 16], b"x", &mut [0]).is_err());
+}
