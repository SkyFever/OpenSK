+// SPDX-License-Identifier: Apache-2.0
+//! Host-only RustCrypto model, not a validation of the Nordic binary.
+use aes::cipher::{BlockDecrypt, BlockEncrypt, KeyInit, KeyIvInit, StreamCipher};
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn opensk_cc310_aes128_cipher(
+    mode: u32, encrypt: bool, key: *const u8, iv: *const u8, input: *const u8, size: usize,
+    output: *mut u8, _capacity: usize,
+) -> i32 {
+    let key = unsafe { &*key.cast::<[u8; 16]>() };
+    let iv = unsafe { &*iv.cast::<[u8; 16]>() };
+    let data = unsafe { core::slice::from_raw_parts(input, size) };
+    let output = unsafe { core::slice::from_raw_parts_mut(output, size) };
+    output.copy_from_slice(data);
+    if mode == 2 {
+        ctr::Ctr128BE::<aes::Aes128>::new(key.into(), iv.into()).apply_keystream(output);
+        return 0;
+    }
+    let cipher = aes::Aes128::new(key.into());
+    let mut chain = *iv;
+    for block in output.chunks_exact_mut(16) {
+        let previous: [u8; 16] = block.try_into().unwrap();
+        if encrypt {
+            if mode == 1 {
+                for i in 0 .. 16 {
+                    block[i] ^= chain[i];
+                }
+            }
+            cipher.encrypt_block(block.into());
+            chain.copy_from_slice(block);
+        } else {
+            cipher.decrypt_block(block.into());
+            if mode == 1 {
+                for i in 0 .. 16 {
+                    block[i] ^= chain[i];
+                }
+            }
+            chain = previous;
+        }
+    }
+    0
+}
+pub unsafe fn opensk_cc310_aes128_mac(
+    is_cmac: bool, key: *const u8, input: *const u8, size: usize, output: *mut u8,
+) -> i32 {
+    let key = unsafe { &*key.cast::<[u8; 16]>() };
+    let data = unsafe { core::slice::from_raw_parts(input, size) };
+    let output = unsafe { &mut *output.cast::<[u8; 16]>() };
+    if is_cmac {
+        use cmac::Mac;
+        let mut ctx = <cmac::Cmac<aes::Aes128> as Mac>::new_from_slice(key).unwrap();
+        ctx.update(data);
+        output.copy_from_slice(&ctx.finalize().into_bytes());
+    } else {
+        let cipher = aes::Aes128::new(key.into());
+        output.fill(0);
+        for block in data.chunks_exact(16) {
+            for i in 0 .. 16 {
+                output[i] ^= block[i];
+            }
+            cipher.encrypt_block(output.into());
+        }
+    }
+    0
+}
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn opensk_cc310_aes128_ccm(
+    encrypt: bool, key: *const u8, nonce: *const u8, nonce_size: usize, aad: *const u8,
+    aad_size: usize, input: *const u8, input_size: usize, output: *mut u8, output_size: usize,
+    tag_size: usize,
+) -> i32 {
+    use ccm::aead::AeadInPlace;
+    use ccm::aead::generic_array::GenericArray;
+    let key = unsafe { &*key.cast::<[u8; 16]>() };
+    let nonce = unsafe { core::slice::from_raw_parts(nonce, nonce_size) };
+    let aad = unsafe { core::slice::from_raw_parts(aad, aad_size) };
+    let input = unsafe { core::slice::from_raw_parts(input, input_size) };
+    let output = unsafe { core::slice::from_raw_parts_mut(output, output_size) };
+    macro_rules! run {
+        ($tag:ty) => {{
+            let ctx = ccm::Ccm::<aes::Aes128, $tag, typenum::U13>::new(key.into());
+            if encrypt {
+                let n = output_size - tag_size;
+                output[.. n].copy_from_slice(input);
+                match ctx.encrypt_in_place_detached(
+                    GenericArray::from_slice(nonce),
+                    aad,
+                    &mut output[.. n],
+                ) {
+                    Ok(tag) => output[n ..].copy_from_slice(&tag),
+                    Err(_) => return -135,
+                }
+            } else {
+                output.copy_from_slice(&input[.. output_size]);
+                if ctx
+                    .decrypt_in_place_detached(
+                        GenericArray::from_slice(nonce),
+                        aad,
+                        output,
+                        GenericArray::from_slice(&input[output_size ..]),
+                    )
+                    .is_err()
+                {
+                    return -149;
+                }
+            }
+        }};
+    }
+    if nonce_size != 13 {
+        return -134;
+    }
+    match tag_size {
+        4 => run!(typenum::U4),
+        8 => run!(typenum::U8),
+        16 => run!(typenum::U16),
+        _ => return -134,
+    }
+    0
+}
+
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn opensk_cc310_ccm_detached(
+    encrypt: bool, key: *const u8, nonce: *const u8, aad: *const u8, aad_size: usize,
+    input: *const u8, size: usize, output: *mut u8, tag: *mut u8,
+) -> i32 {
+    let input = unsafe { core::slice::from_raw_parts(input, size) }.to_vec();
+    let mut combined = alloc::vec![0;size+4];
+    if encrypt {
+        let result = unsafe {
+            opensk_cc310_aes128_ccm(
+                true,
+                key,
+                nonce,
+                13,
+                aad,
+                aad_size,
+                input.as_ptr(),
+                size,
+                combined.as_mut_ptr(),
+                size + 4,
+                4,
+            )
+        };
+        if result == 0 {
+            unsafe {
+                core::ptr::copy_nonoverlapping(combined.as_ptr(), output, size);
+                core::ptr::copy_nonoverlapping(combined.as_ptr().add(size), tag, 4);
+            }
+        }
+        result
+    } else {
+        combined[.. size].copy_from_slice(&input);
+        combined[size ..].copy_from_slice(unsafe { core::slice::from_raw_parts(tag, 4) });
+        unsafe {
+            opensk_cc310_aes128_ccm(
+                false,
+                key,
+                nonce,
+                13,
+                aad,
+                aad_size,
+                combined.as_ptr(),
+                size + 4,
+                output,
+                size,
+                4,
+            )
+        }
+    }
+}
