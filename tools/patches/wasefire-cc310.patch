+// SPDX-License-Identifier: Apache-2.0
+//! Host-only software model of the C shim. This does not exercise CC310 hardware.
+use core::sync::atomic::{AtomicI32, Ordering};
+
+use p256::ecdsa::signature::hazmat::{PrehashSigner, PrehashVerifier};
+use p256::ecdsa::{Signature, SigningKey, VerifyingKey};
+use p256::{PublicKey, SecretKey};
+
+pub static INIT_ERROR: AtomicI32 = AtomicI32::new(0);
+
+pub unsafe fn opensk_cc310_init() -> i32 {
+    INIT_ERROR.swap(0, Ordering::Relaxed)
+}
+
+unsafe fn input<'a, const N: usize>(ptr: *const u8) -> &'a [u8; N] {
+    // SAFETY: Tests use the same buffer contracts as the C shim.
+    unsafe { &*ptr.cast() }
+}
+
+pub unsafe fn opensk_cc310_generate(private: *mut u8) -> i32 {
+    let mut value = [0; 32];
+    value[31] = 1; // Only a deterministic test fixture, never compiled into firmware.
+    unsafe { core::ptr::copy_nonoverlapping(value.as_ptr(), private, 32) };
+    0
+}
+
+pub unsafe fn opensk_cc310_public(private: *const u8, public: *mut u8) -> i32 {
+    let Ok(key) = SigningKey::from_slice(unsafe { input::<32>(private) }) else { return -135 };
+    let encoded = key.verifying_key().to_encoded_point(false);
+    unsafe { core::ptr::copy_nonoverlapping(encoded.as_bytes()[1 ..].as_ptr(), public, 64) };
+    0
+}
+
+fn encoded(public: &[u8; 64]) -> [u8; 65] {
+    let mut value = [0; 65];
+    value[0] = 4;
+    value[1 ..].copy_from_slice(public);
+    value
+}
+
+pub unsafe fn opensk_cc310_validate_public(public: *const u8) -> i32 {
+    if PublicKey::from_sec1_bytes(&encoded(unsafe { input::<64>(public) })).is_ok() {
+        0
+    } else {
+        -135
+    }
+}
+
+pub unsafe fn opensk_cc310_sign(private: *const u8, digest: *const u8, signature: *mut u8) -> i32 {
+    let Ok(key) = SigningKey::from_slice(unsafe { input::<32>(private) }) else { return -135 };
+    let value: Signature = key.sign_prehash(unsafe { input::<32>(digest) }).unwrap();
+    unsafe { core::ptr::copy_nonoverlapping(value.to_bytes().as_ptr(), signature, 64) };
+    0
+}
+
+pub unsafe fn opensk_cc310_verify(
+    public: *const u8, digest: *const u8, signature: *const u8,
+) -> i32 {
+    let Ok(key) = VerifyingKey::from_sec1_bytes(&encoded(unsafe { input::<64>(public) })) else {
+        return -135;
+    };
+    let Ok(sig) = Signature::from_slice(unsafe { input::<64>(signature) }) else { return -149 };
+    if key.verify_prehash(unsafe { input::<32>(digest) }, &sig).is_ok() { 0 } else { -149 }
+}
+
+pub unsafe fn opensk_cc310_shared(private: *const u8, public: *const u8, shared: *mut u8) -> i32 {
+    let Ok(key) = SecretKey::from_slice(unsafe { input::<32>(private) }) else { return -135 };
+    let Ok(public) = PublicKey::from_sec1_bytes(&encoded(unsafe { input::<64>(public) })) else {
+        return -135;
+    };
+    let value = p256::ecdh::diffie_hellman(key.to_nonzero_scalar(), public.as_affine());
+    unsafe { core::ptr::copy_nonoverlapping(value.raw_secret_bytes().as_ptr(), shared, 32) };
+    0
+}
