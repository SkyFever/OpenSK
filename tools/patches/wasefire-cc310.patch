+static TEST: Mutex<()> = Mutex::new(());
+fn key(value: u8) -> [u8; 32] {
+    let mut key = [0; 32];
+    key[31] = value;
+    key
+}
+fn hex<const N: usize>(input: &str) -> [u8; N] {
+    let mut out = [0; N];
+    assert_eq!(input.len(), N * 2);
+    for (i, byte) in out.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&input[2 * i .. 2 * i + 2], 16).unwrap();
+    }
+    out
