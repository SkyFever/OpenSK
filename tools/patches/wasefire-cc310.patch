+[package]
+name = "wasefire-nrf-cc310"
+version = "0.1.0"
+edition = "2024"
+license = "Apache-2.0"
+publish = false
+
+[features]
+# Optional board LED tracing; absent from normal firmware.
+trace = []
+ed25519 = ["wasefire-board-api/api-crypto-ed25519"]
+symmetric = [
+  "dep:digest", "dep:typenum",
+  "wasefire-board-api/api-crypto-hmac-sha256",
+  "wasefire-board-api/api-crypto-sha256",
+]
+
+[dependencies]
+digest = { version = "0.10.7", default-features = false, optional = true, features = ["mac"] }
+typenum = { version = "1.20.1", default-features = false, optional = true }
+wasefire-error = { path = "../../../error" }
+wasefire-board-api = { path = "../../../board", features = ["api-crypto-p256-ecdh", "api-crypto-p256-ecdsa"] }
+zeroize = { version = "1.8.2", default-features = false, features = ["alloc"] }
+
+[dev-dependencies]
+ed25519-dalek = { version = "2.2.0", default-features = false }
+sha2 = "0.10.9"
+hmac = "0.12.1"
+p256 = { version = "0.13.2", default-features = false, features = ["ecdsa", "ecdh"] }
+
+[lints]
+rust.unsafe_op_in_unsafe_fn = "deny"
