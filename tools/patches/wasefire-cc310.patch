+[package]
+name = "wasefire-nrf-cc310"
+version = "0.1.0"
+edition = "2024"
+license = "Apache-2.0"
+publish = false
+
+[features]
+# Optional board LED tracing; absent from normal firmware.
+trace = []
+random = []
+hashes = []
+x25519 = []
+ecc = []
+rsa = []
+srp = ["random"]
+self-test = ["ed25519", "random", "symmetric", "hashes", "aes128",
+  "chacha20poly1305", "x25519", "ecc", "rsa", "srp"]
+chacha20poly1305 = []
+aes128 = ["dep:typenum", "wasefire-board-api/api-crypto-aes128-ccm"]
+ed25519 = ["wasefire-board-api/api-crypto-ed25519"]
+symmetric = [
+  "dep:digest", "dep:typenum",
+  "wasefire-board-api/api-crypto-hmac-sha256",
+  "wasefire-board-api/api-crypto-sha256",
+]
+
+[dependencies]
+digest = { version = "0.10.7", default-features = false, optional = true, features = ["mac"] }
+typenum = { version = "1.20.1", default-features = false, optional = true }
+wasefire-error = { path = "../../../error" }
+wasefire-board-api = { path = "../../../board", features = ["api-crypto-p256-ecdh", "api-crypto-p256-ecdsa"] }
+zeroize = { version = "1.8.2", default-features = false, features = ["alloc"] }
+
+[dev-dependencies]
+openssl = "0.10.75"
+x25519-dalek = { version = "2.0.1", default-features = false, features = ["static_secrets"] }
+chacha20poly1305 = { version = "0.10.1", default-features = false }
+aes = "0.8.4"
+ctr = "0.9.2"
+cmac = "0.7.2"
+ccm = "0.5.0"
+sha1 = "0.10.6"
+ed25519-dalek = { version = "2.2.0", default-features = false }
+sha2 = "0.10.9"
+hmac = "0.12.1"
+p256 = { version = "0.13.2", default-features = false, features = ["ecdsa", "ecdh"] }
+
+[lints]
+rust.unsafe_op_in_unsafe_fn = "deny"
diff --git a/crates/runner-nordic/crates/cc310/build.rs b/crates/runner-nordic/crates/cc310/build.rs
new file mode 100644
index 00000000..30c8e4b2
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/build.rs
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+use std::path::PathBuf;
+use std::process::Command;
+
+fn run(command: &mut Command) {
+    let status = command.status().expect("could not start CC310 C toolchain");
+    assert!(status.success(), "CC310 C toolchain failed");
+}
+
+fn main() {
+    // Host tests exercise the Rust adapter with a software driver model.
+    if std::env::var("CARGO_CFG_TARGET_ARCH").as_deref() != Ok("arm") {
+        return;
+    }
+    assert_eq!(
+        std::env::var("TARGET").unwrap(),
+        "thumbv7em-none-eabi",
+        "CC310 archive requires the Cortex-M4 soft-float ABI"
+    );
+    let cache = std::env::var_os("OPENSK_CC310_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("../../../../.root/cc310"));
+    let cache = cache
+        .canonicalize()
+        .expect("CC310 dependencies are missing: run python3 tools/setup_cc310.py from OpenSK");
+    println!("cargo::rerun-if-changed={}", cache.display());
+    let nordic = cache.join("nrfxlib/crypto");
+    let out = PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+    let cc = std::env::var_os("CC310_CC").unwrap_or_else(|| "clang-18".into());
+    let srp = std::env::var_os("CARGO_FEATURE_SRP").is_some();
+    let mut compiler = Command::new(cc);
+    if srp {
+        compiler.arg("-DOPENSK_CC310_SRP");
+    }
+    run(compiler
+        .args([
+            "--target=thumbv7em-none-eabi",
+            "-mcpu=cortex-m4",
+            "-mthumb",
+            "-mfloat-abi=soft",
+            "-std=c11",
+            "-Os",
+            "-ffreestanding",
+            "-fno-builtin",
+            "-ffunction-sections",
+            "-fdata-sections",
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            "-DMBEDTLS_CONFIG_FILE=\"cc310_config.h\"",
+        ])
+        .arg("-I")
+        .arg("src")
+        .arg("-I")
+        .arg(cache.join("mbedtls/include"))
+        .arg("-I")
+        .arg(nordic.join("nrf_cc310_mbedcrypto/include"))
+        .arg("-I")
+        .arg(nordic.join("nrf_cc310_platform/include"))
+        .args(["-c", "src/cc310.c", "-o"])
+        .arg(out.join("cc310.o")));
+    let ar = std::env::var_os("CC310_AR").unwrap_or_else(|| "llvm-ar".into());
+    run(Command::new(ar).arg("crs").arg(out.join("libopensk_cc310.a")).arg(out.join("cc310.o")));
+    println!("cargo::rustc-link-search=native={}", out.display());
+    println!("cargo::rustc-link-lib=static=opensk_cc310");
+    for (directory, name) in [
+        ("nrf_cc310_mbedcrypto", "nrf_cc310_psa_crypto_0.9.19"),
+        ("nrf_cc310_mbedcrypto", "nrf_cc310_core_0.9.19"),
+        ("nrf_cc310_platform", "nrf_cc310_platform_0.9.19"),
+    ] {
+        let path = nordic.join(directory).join("lib/cortex-m4/soft-float/no-interrupts");
+        assert!(path.join(format!("lib{name}.a")).is_file(), "missing CC310 archive");
+        println!("cargo::rustc-link-search=native={}", path.display());
+        println!("cargo::rustc-link-lib=static={name}");
+        println!("cargo::rerun-if-changed={}", path.display());
+    }
+    if srp {
+        let path = nordic.join("nrf_cc310_mbedcrypto/lib/cortex-m4/soft-float/no-interrupts");
+        println!("cargo::rustc-link-search=native={}", path.display());
+        println!("cargo::rustc-link-lib=static=nrf_cc310_legacy_crypto_0.9.19");
+        // Legacy SRP references the same version of the shared core.
+        println!("cargo::rustc-link-lib=static=nrf_cc310_core_0.9.19");
+        println!("cargo::rustc-link-lib=static=nrf_cc310_platform_0.9.19");
+    }
+    for name in ["OPENSK_CC310_DIR", "CC310_CC", "CC310_AR"] {
+        println!("cargo::rerun-if-env-changed={name}");
+    }
+    println!("cargo::rerun-if-changed=src/cc310.c");
+    println!("cargo::rerun-if-changed=src/cc310_config.h");
+    println!("cargo::rerun-if-changed=src/cc_pka_hw_plat_defs.h");
+}
