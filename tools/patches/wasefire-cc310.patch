+    let mut exported = [0; 32];
+    <Impl as ecdsa::Api<32>>::export_private(&imported, &mut exported).unwrap();
+    assert_eq!(exported, key);
+    assert_eq!(<Impl as ecdsa::Api<32>>::WRAPPED, 32);
+    assert_eq!(<Impl as ecdsa::Api<32>>::PRIVATE, Layout::new::<[u8; 32]>());
+    assert_eq!(<Impl as ecdh::Api<32>>::PRIVATE, Layout::new::<[u8; 32]>());
