index 00000000..b0a8cda2
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/src/ecc_model.rs
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Host-only OpenSSL model for all eight PSA-exposed curves.
+use openssl::bn::{BigNum, BigNumContext};
+use openssl::derive::Deriver;
+use openssl::ec::{EcGroup, EcKey, EcPoint, PointConversionForm};
+use openssl::ecdsa::EcdsaSig;
+use openssl::nid::Nid;
+use openssl::pkey::{PKey, Private};
+fn group(curve: u32) -> EcGroup {
+    let nid = match curve {
+        0 => Nid::X9_62_PRIME192V1,
+        1 => Nid::SECP224R1,
+        2 => Nid::X9_62_PRIME256V1,
+        3 => Nid::SECP384R1,
+        4 => Nid::SECP192K1,
+        5 => Nid::SECP224K1,
+        6 => Nid::SECP256K1,
+        7 => Nid::BRAINPOOL_P256R1,
+        _ => unreachable!(),
+    };
+    EcGroup::from_curve_name(nid).unwrap()
+}
+fn private(curve: u32, key: &[u8]) -> EcKey<Private> {
+    let group = group(curve);
+    let n = BigNum::from_slice(key).unwrap();
+    let mut point = EcPoint::new(&group).unwrap();
+    let mut ctx = BigNumContext::new().unwrap();
+    point.mul_generator2(&group, &n, &mut ctx).unwrap();
+    EcKey::from_private_components(&group, &n, &point).unwrap()
+}
+pub unsafe fn opensk_cc310_ecc_generate(_curve: u32, output: *mut u8, size: usize) -> i32 {
+    unsafe {
+        core::ptr::write_bytes(output, 0, size);
+        output.add(size - 1).write(1);
+    }
+    0
+}
+pub unsafe fn opensk_cc310_ecc_public(
+    curve: u32, key: *const u8, key_size: usize, output: *mut u8, size: usize,
+) -> i32 {
+    let key = private(curve, unsafe { core::slice::from_raw_parts(key, key_size) });
+    let mut ctx = BigNumContext::new().unwrap();
+    let value = key
+        .public_key()
+        .to_bytes(key.group(), PointConversionForm::UNCOMPRESSED, &mut ctx)
+        .unwrap();
+    unsafe { core::slice::from_raw_parts_mut(output, size) }.copy_from_slice(&value);
+    0
+}
+pub unsafe fn opensk_cc310_ecc_sign(
+    curve: u32, key: *const u8, key_size: usize, hash: *const u8, hash_size: usize,
+    output: *mut u8, size: usize,
+) -> i32 {
+    let key = private(curve, unsafe { core::slice::from_raw_parts(key, key_size) });
+    let sig =
+        EcdsaSig::sign(unsafe { core::slice::from_raw_parts(hash, hash_size) }, &key).unwrap();
+    let output = unsafe { core::slice::from_raw_parts_mut(output, size) };
+    output[.. size / 2].copy_from_slice(&sig.r().to_vec_padded((size / 2) as i32).unwrap());
+    output[size / 2 ..].copy_from_slice(&sig.s().to_vec_padded((size / 2) as i32).unwrap());
+    0
+}
+pub unsafe fn opensk_cc310_ecc_verify(
+    curve: u32, key: *const u8, key_size: usize, hash: *const u8, hash_size: usize, sig: *const u8,
+    sig_size: usize,
+) -> i32 {
+    let group = group(curve);
+    let mut ctx = BigNumContext::new().unwrap();
+    let Ok(point) = EcPoint::from_bytes(
+        &group,
+        unsafe { core::slice::from_raw_parts(key, key_size) },
+        &mut ctx,
+    ) else {
+        return -135;
+    };
+    let key = EcKey::from_public_key(&group, &point).unwrap();
+    let sig = unsafe { core::slice::from_raw_parts(sig, sig_size) };
+    let sig = EcdsaSig::from_private_components(
+        BigNum::from_slice(&sig[.. sig_size / 2]).unwrap(),
+        BigNum::from_slice(&sig[sig_size / 2 ..]).unwrap(),
+    )
+    .unwrap();
+    if sig.verify(unsafe { core::slice::from_raw_parts(hash, hash_size) }, &key).unwrap_or(false) {
+        0
+    } else {
+        -149
+    }
+}
+pub unsafe fn opensk_cc310_ecc_shared(
+    curve: u32, key: *const u8, key_size: usize, peer: *const u8, peer_size: usize,
+    output: *mut u8, size: usize,
+) -> i32 {
+    let key =
+        PKey::from_ec_key(private(curve, unsafe { core::slice::from_raw_parts(key, key_size) }))
+            .unwrap();
+    let group = group(curve);
+    let mut ctx = BigNumContext::new().unwrap();
+    let Ok(point) = EcPoint::from_bytes(
+        &group,
+        unsafe { core::slice::from_raw_parts(peer, peer_size) },
+        &mut ctx,
+    ) else {
+        return -135;
+    };
+    let peer = PKey::from_ec_key(EcKey::from_public_key(&group, &point).unwrap()).unwrap();
+    let mut deriver = Deriver::new(&key).unwrap();
+    if deriver.set_peer(&peer).is_err() {
+        return -135;
+    }
+    let Ok(value) = deriver.derive_to_vec() else {
+        return -135;
+    };
+    unsafe { core::slice::from_raw_parts_mut(output, size) }.copy_from_slice(&value);
+    0
+}
