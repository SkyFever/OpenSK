@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: Apache-2.0
+//! nRF52840 CC310 P-256 adapter. Keys retain Wasefire's big-endian wire format.
+#![no_std]
+
+extern crate alloc;
+
+use core::alloc::Layout;
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use wasefire_board_api::crypto::{ecdh, ecdsa};
+use wasefire_board_api::{Error, Supported};
+use wasefire_error::Code;
+
+#[cfg(feature = "symmetric")]
+mod symmetric;
+#[cfg(feature = "symmetric")]
+pub use symmetric::{HmacSha256, Sha256};
+use zeroize::{Zeroize, Zeroizing};
+
+#[cfg(feature = "ed25519")]
+mod ed25519;
+#[cfg(feature = "ed25519")]
+pub use ed25519::Ed25519;
+
+#[cfg(feature = "random")]
+mod random;
+#[cfg(feature = "random")]
+pub use random::{fill_entropy, fill_random};
+
+#[cfg(feature = "hashes")]
+pub mod hashes;
+
+#[cfg(feature = "aes128")]
+pub mod aes128;
+
+#[cfg(feature = "chacha20poly1305")]
+pub mod chacha20poly1305;
+
+#[cfg(feature = "x25519")]
+pub mod x25519;
+
+#[cfg(feature = "ecc")]
+pub mod ecc;
+
+#[cfg(feature = "rsa")]
+pub mod rsa;
+
+#[cfg(all(feature = "srp", target_arch = "arm"))]
+pub mod srp;
+
+#[cfg(all(feature = "self-test", target_arch = "arm"))]
+pub mod self_test;
+
+pub enum Impl {}
+impl Supported for Impl {}
+
+const PRIVATE: Layout = Layout::new::<[u8; 32]>();
+const PUBLIC: Layout = Layout::new::<[u8; 64]>();
+const INVALID_SIGNATURE: i32 = -149;
+static BUSY: AtomicBool = AtomicBool::new(false);
+
+// Order of the NIST P-256 base point (SEC 2), in big-endian.
+const ORDER: [u8; 32] = [
+    0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84, 0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x51,
+];
+
+struct Guard;
+impl Drop for Guard {
+    fn drop(&mut self) {
+        BUSY.store(false, Ordering::Release);
+    }
+}
+
+fn driver(f: impl FnOnce() -> i32) -> Result<(), Error> {
+    if BUSY.compare_exchange(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {
+        return Err(Error::world(0));
+    }
+    let _guard = Guard;
+    // SAFETY: All accesses to the global driver are serialized by BUSY.
+    status(unsafe { ffi::opensk_cc310_init() })?;
+    status(f())
+}
+
+// Diagnostic colors encode the operation active inside the hardware driver.
+// A returned error latches its color in the runner, including during cleanup.
+fn traced_driver(operation: u32, f: impl FnOnce() -> i32) -> Result<(), Error> {
+    #[cfg(all(feature = "trace", not(test)))]
+    unsafe extern "C" {
+        fn opensk_cc310_trace(operation: u32);
+    }
+    #[cfg(all(feature = "trace", not(test)))]
+    // SAFETY: The Nordic runner supplies a synchronous, non-crypto LED hook.
+    unsafe {
+        opensk_cc310_trace(operation)
+    };
+    let result = driver(f);
+    #[cfg(all(feature = "trace", not(test)))]
+    // SAFETY: Same runner hook; bit 31 distinguishes a returned driver error.
+    unsafe {
+        opensk_cc310_trace(if result.is_ok() { 0 } else { operation | (1 << 31) })
+    };
+    #[cfg(any(not(feature = "trace"), test))]
+    let _ = operation;
+    result
+}
+
+fn status(code: i32) -> Result<(), Error> {
+    match code {
+        0 => Ok(()),
+        -135 | -138 => Err(Error::user(0)), // PSA invalid argument or buffer too small.
+        _ => Err(Error::world(0)),          /* Never fall back to software after a hardware
+                                              * failure. */
+    }
+}
+
+fn length(bytes: &[u8], expected: usize) -> Result<(), Error> {
+    if bytes.len() == expected { Ok(()) } else { Err(Error::user(Code::InvalidLength)) }
+}
+
+fn private(bytes: &[u8]) -> Result<(), Error> {
+    length(bytes, 32)?;
+    if bytes.iter().any(|&x| x != 0) && bytes < ORDER.as_slice() {
+        Ok(())
+    } else {
+        Err(Error::user(0))
+    }
+}
+
+fn generate(output: &mut [u8]) -> Result<(), Error> {
+    length(output, 32)?;
+    let mut value = Zeroizing::new([0; 32]);
+    // SAFETY: The driver gets a writable, exactly 32-byte buffer for this call only.
+    traced_driver(3, || unsafe { ffi::opensk_cc310_generate(value.as_mut_ptr()) })?;
+    private(value.as_ref())?;
+    output.copy_from_slice(value.as_ref());
+    Ok(())
+}
+
+fn derive_public(key: &[u8], output: &mut [u8]) -> Result<(), Error> {
+    private(key)?;
+    length(output, 64)?;
+    let mut value = [0; 64];
+    // SAFETY: key and value remain alive and have the sizes required by the C shim.
+    traced_driver(4, || unsafe { ffi::opensk_cc310_public(key.as_ptr(), value.as_mut_ptr()) })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+
+fn import_public(x: &[u8; 32], y: &[u8; 32], output: &mut [u8]) -> Result<(), Error> {
+    length(output, 64)?;
+    let mut value = [0; 64];
+    value[.. 32].copy_from_slice(x);
+    value[32 ..].copy_from_slice(y);
+    // SAFETY: value is an exactly 64-byte SEC-1 point without the uncompressed prefix.
+    traced_driver(4, || unsafe { ffi::opensk_cc310_validate_public(value.as_ptr()) })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+
+fn export_public(key: &[u8], x: &mut [u8; 32], y: &mut [u8; 32]) -> Result<(), Error> {
+    length(key, 64)?;
+    x.copy_from_slice(&key[.. 32]);
+    y.copy_from_slice(&key[32 ..]);
+    Ok(())
+}
+
+fn drop_secret(secret: &mut [u8]) -> Result<(), Error> {
+    length(secret, 32)?;
+    secret.zeroize();
+    Ok(())
+}
+
+impl ecdsa::Api<32> for Impl {
+    const PRIVATE: Layout = PRIVATE;
+    const PUBLIC: Layout = PUBLIC;
+    const WRAPPED: usize = 32;
+
+    fn generate(private: &mut [u8]) -> Result<(), Error> {
+        generate(private)
+    }
+    fn public(private: &[u8], public: &mut [u8]) -> Result<(), Error> {
+        derive_public(private, public)
+    }
+
+    fn sign(
+        key: &[u8], digest: &[u8; 32], r: &mut [u8; 32], s: &mut [u8; 32],
+    ) -> Result<(), Error> {
+        private(key)?;
+        let mut value = Zeroizing::new([0; 64]);
+        // SAFETY: All pointers refer to appropriately sized buffers alive throughout the call.
+        traced_driver(5, || unsafe {
+            ffi::opensk_cc310_sign(key.as_ptr(), digest.as_ptr(), value.as_mut_ptr())
+        })?;
+        r.copy_from_slice(&value[.. 32]);
+        s.copy_from_slice(&value[32 ..]);
+        Ok(())
+    }
+
+    fn verify(key: &[u8], digest: &[u8; 32], r: &[u8; 32], s: &[u8; 32]) -> Result<bool, Error> {
+        length(key, 64)?;
+        private(r)?;
+        private(s)?;
+        let mut signature = [0; 64];
+        signature[.. 32].copy_from_slice(r);
+        signature[32 ..].copy_from_slice(s);
+        let mut valid = true;
+        traced_driver(5, || {
+            // SAFETY: All pointers refer to appropriately sized buffers alive throughout the call.
+            let result = unsafe {
+                ffi::opensk_cc310_verify(key.as_ptr(), digest.as_ptr(), signature.as_ptr())
+            };
+            if result == INVALID_SIGNATURE {
+                valid = false;
+                0
+            } else {
+                result
+            }
+        })?;
+        Ok(valid)
+    }
+
+    fn drop_private(private: &mut [u8]) -> Result<(), Error> {
+        drop_secret(private)
+    }
+
+    fn export_private(key: &[u8], wrapped: &mut [u8]) -> Result<(), Error> {
+        private(key)?;
+        length(wrapped, 32)?;
+        wrapped.copy_from_slice(key);
+        Ok(())
+    }
+
+    fn import_private(wrapped: &[u8], output: &mut [u8]) -> Result<(), Error> {
+        private(wrapped)?;
+        length(output, 32)?;
+        output.copy_from_slice(wrapped);
+        Ok(())
+    }
+
+    fn export_public(key: &[u8], x: &mut [u8; 32], y: &mut [u8; 32]) -> Result<(), Error> {
+        export_public(key, x, y)
+    }
+
+    fn import_public(x: &[u8; 32], y: &[u8; 32], output: &mut [u8]) -> Result<(), Error> {
+        import_public(x, y, output)
+    }
+}
+
+impl ecdh::Api<32> for Impl {
+    const PRIVATE: Layout = PRIVATE;
+    const PUBLIC: Layout = PUBLIC;
+    const SHARED: Layout = PRIVATE;
+
+    fn generate(private: &mut [u8]) -> Result<(), Error> {
+        generate(private)
+    }
+    fn public(private: &[u8], public: &mut [u8]) -> Result<(), Error> {
+        derive_public(private, public)
+    }
+
+    fn shared(key: &[u8], public: &[u8], output: &mut [u8]) -> Result<(), Error> {
+        private(key)?;
+        length(public, 64)?;
+        length(output, 32)?;
+        let mut value = Zeroizing::new([0; 32]);
+        // SAFETY: All pointers refer to appropriately sized buffers alive throughout the call.
+        traced_driver(6, || unsafe {
+            ffi::opensk_cc310_shared(key.as_ptr(), public.as_ptr(), value.as_mut_ptr())
+        })?;
+        output.copy_from_slice(value.as_ref());
+        Ok(())
+    }
+
+    fn drop_private(private: &mut [u8]) -> Result<(), Error> {
+        drop_secret(private)
+    }
+    fn drop_shared(shared: &mut [u8]) -> Result<(), Error> {
+        drop_secret(shared)
+    }
+
+    fn export_public(key: &[u8], x: &mut [u8; 32], y: &mut [u8; 32]) -> Result<(), Error> {
+        export_public(key, x, y)
+    }
+
+    fn import_public(x: &[u8; 32], y: &[u8; 32], output: &mut [u8]) -> Result<(), Error> {
+        import_public(x, y, output)
+    }
+
+    fn export_shared(shared: &[u8], x: &mut [u8; 32]) -> Result<(), Error> {
+        length(shared, 32)?;
+        x.copy_from_slice(shared);
+        Ok(())
+    }
+}
+
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_init() -> i32;
+        pub fn opensk_cc310_generate(private: *mut u8) -> i32;
+        pub fn opensk_cc310_public(private: *const u8, public: *mut u8) -> i32;
+        pub fn opensk_cc310_validate_public(public: *const u8) -> i32;
+        pub fn opensk_cc310_sign(private: *const u8, digest: *const u8, signature: *mut u8) -> i32;
+        pub fn opensk_cc310_verify(
+            public: *const u8, digest: *const u8, signature: *const u8,
+        ) -> i32;
+        pub fn opensk_cc310_shared(private: *const u8, public: *const u8, shared: *mut u8) -> i32;
+    }
+}
+
+// Nordic's archives use Mbed TLS allocation symbols. Keep an allocation header
+// so free can recover the Rust Layout; wipe the complete allocation on release.
+/// Allocates zero-filled memory for the Nordic archive.
+///
+/// # Safety
+/// The returned allocation must be released exactly once with mbedtls_free.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn mbedtls_calloc(count: usize, size: usize) -> *mut core::ffi::c_void {
+    let Some(bytes) = count.checked_mul(size).and_then(|n| n.checked_add(8)) else {
+        return core::ptr::null_mut();
+    };
+    let Ok(layout) = Layout::from_size_align(bytes, 8) else {
+        return core::ptr::null_mut();
+    };
+    // SAFETY: layout has nonzero size and valid alignment.
+    let ptr = unsafe { alloc::alloc::alloc_zeroed(layout) };
+    if ptr.is_null() {
+        return ptr.cast();
+    }
+    // SAFETY: The 8-byte allocation header fits and is aligned for usize on Cortex-M4 and hosts.
+    unsafe {
+        ptr.cast::<usize>().write(bytes);
+        ptr.add(8).cast()
+    }
+}
+
+/// Wipes and releases a Nordic archive allocation.
+///
+/// # Safety
+/// ptr must be null or a live pointer returned by mbedtls_calloc, used once.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn mbedtls_free(ptr: *mut core::ffi::c_void) {
+    if ptr.is_null() {
+        return;
+    }
+    // SAFETY: The caller must pass exactly a pointer returned by mbedtls_calloc, once.
+    let base = unsafe { ptr.cast::<u8>().sub(8) };
+    let bytes = unsafe { base.cast::<usize>().read() };
+    let layout = Layout::from_size_align(bytes, 8).unwrap();
+    // SAFETY: This range is the entire live allocation; its header is no longer needed.
+    unsafe {
+        core::slice::from_raw_parts_mut(base, bytes).zeroize();
+        alloc::alloc::dealloc(base, layout);
+    }
+}
+
+#[cfg(test)]
+#[path = "model.rs"]
+mod ffi;
+#[cfg(test)]
+mod tests;
