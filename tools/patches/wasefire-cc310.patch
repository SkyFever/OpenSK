+++ b/crates/runner-nordic/crates/cc310/src/ecc.rs
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Additional Weierstrass curves exposed by the pinned Nordic PSA driver.
+use alloc::vec;
+
+use wasefire_board_api::Error;
+use zeroize::Zeroizing;
+
+use crate::{INVALID_SIGNATURE, driver, length};
+#[derive(Clone, Copy)]
+#[repr(u32)]
+pub enum Curve {
+    P192,
+    P224,
+    P256,
+    P384,
+    Secp192k1,
+    Secp224k1,
+    Secp256k1,
+    BrainpoolP256r1,
+}
+impl Curve {
+    pub const fn scalar_size(self) -> usize {
+        match self {
+            Self::P192 | Self::Secp192k1 => 24,
+            Self::P224 | Self::Secp224k1 => 28,
+            Self::P384 => 48,
+            _ => 32,
+        }
+    }
+    pub const fn public_size(self) -> usize {
+        1 + 2 * self.scalar_size()
+    }
+}
+fn private(curve: Curve, value: &[u8]) -> Result<(), Error> {
+    length(value, curve.scalar_size())?;
+    if value.iter().all(|&x| x == 0) {
+        return Err(Error::user(0));
+    }
+    Ok(())
+}
+fn point(curve: Curve, value: &[u8]) -> Result<(), Error> {
+    length(value, curve.public_size())?;
+    if value[0] != 4 {
+        return Err(Error::user(0));
+    }
+    Ok(())
+}
+fn digest(value: &[u8]) -> Result<(), Error> {
+    if matches!(value.len(), 20 | 28 | 32 | 48 | 64) { Ok(()) } else { Err(Error::user(0)) }
+}
+pub fn generate(curve: Curve, output: &mut [u8]) -> Result<(), Error> {
+    length(output, curve.scalar_size())?;
+    let mut value = Zeroizing::new(vec![0; output.len()]);
+    // SAFETY: Typed curve and sized output match the Nordic attribute mapping.
+    driver(|| unsafe {
+        ffi::opensk_cc310_ecc_generate(curve as u32, value.as_mut_ptr(), value.len())
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+/// Returns an uncompressed SEC1 point, including the 0x04 prefix.
+pub fn public(curve: Curve, key: &[u8], output: &mut [u8]) -> Result<(), Error> {
+    private(curve, key)?;
+    length(output, curve.public_size())?;
+    let mut value = vec![0; output.len()];
+    // SAFETY: Typed curve, private scalar and public buffer have exact sizes.
+    driver(|| unsafe {
+        ffi::opensk_cc310_ecc_public(
+            curve as u32,
+            key.as_ptr(),
+            key.len(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+/// Signs an externally computed digest, returning fixed-width big-endian r || s.
+pub fn sign(curve: Curve, key: &[u8], hash: &[u8], output: &mut [u8]) -> Result<(), Error> {
+    private(curve, key)?;
+    digest(hash)?;
+    length(output, 2 * curve.scalar_size())?;
+    let mut value = Zeroizing::new(vec![0; output.len()]);
+    // SAFETY: All lengths were checked and remain valid through the serialized call.
+    driver(|| unsafe {
+        ffi::opensk_cc310_ecc_sign(
+            curve as u32,
+            key.as_ptr(),
+            key.len(),
+            hash.as_ptr(),
+            hash.len(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+pub fn verify(curve: Curve, key: &[u8], hash: &[u8], signature: &[u8]) -> Result<bool, Error> {
+    point(curve, key)?;
+    digest(hash)?;
+    length(signature, 2 * curve.scalar_size())?;
+    let mut valid = true;
+    driver(|| {
+        // SAFETY: Key, digest and signature buffers have validated lengths.
+        let result = unsafe {
+            ffi::opensk_cc310_ecc_verify(
+                curve as u32,
+                key.as_ptr(),
+                key.len(),
+                hash.as_ptr(),
+                hash.len(),
+                signature.as_ptr(),
+                signature.len(),
+            )
+        };
+        if result == INVALID_SIGNATURE {
+            valid = false;
+            0
+        } else {
+            result
+        }
+    })?;
+    Ok(valid)
+}
+pub fn shared(curve: Curve, key: &[u8], peer: &[u8], output: &mut [u8]) -> Result<(), Error> {
+    private(curve, key)?;
+    point(curve, peer)?;
+    length(output, curve.scalar_size())?;
+    let mut value = Zeroizing::new(vec![0; output.len()]);
+    // SAFETY: Input scalars, SEC1 peer and shared-secret output have exact sizes.
+    driver(|| unsafe {
+        ffi::opensk_cc310_ecc_shared(
+            curve as u32,
+            key.as_ptr(),
+            key.len(),
+            peer.as_ptr(),
+            peer.len(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_ecc_generate(curve: u32, output: *mut u8, size: usize) -> i32;
+        pub fn opensk_cc310_ecc_public(
+            curve: u32, key: *const u8, key_size: usize, output: *mut u8, size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_ecc_sign(
+            curve: u32, key: *const u8, key_size: usize, hash: *const u8, hash_size: usize,
+            output: *mut u8, size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_ecc_verify(
+            curve: u32, key: *const u8, key_size: usize, hash: *const u8, hash_size: usize,
+            sig: *const u8, sig_size: usize,
+        ) -> i32;
+        pub fn opensk_cc310_ecc_shared(
+            curve: u32, key: *const u8, key_size: usize, peer: *const u8, peer_size: usize,
+            output: *mut u8, size: usize,
+        ) -> i32;
+    }
+}
+#[cfg(test)]
+#[path = "ecc_model.rs"]
+mod ffi;
