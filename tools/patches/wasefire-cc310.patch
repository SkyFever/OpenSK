+// SPDX-License-Identifier: Apache-2.0
+//! X25519 with the RFC7748 little-endian 32-byte wire encoding.
+use wasefire_board_api::Error;
+use zeroize::Zeroizing;
+
+use crate::driver;
+
+pub fn generate(output: &mut [u8; 32]) -> Result<(), Error> {
+    let mut value = Zeroizing::new([0; 32]);
+    // SAFETY: The driver writes exactly 32 bytes into a live buffer.
+    driver(|| unsafe { ffi::opensk_cc310_x25519_generate(value.as_mut_ptr()) })?;
+    output.copy_from_slice(value.as_ref());
+    Ok(())
+}
+pub fn public(private: &[u8; 32], output: &mut [u8; 32]) -> Result<(), Error> {
+    let mut value = [0; 32];
+    // SAFETY: Both buffers have the fixed sizes required by the C shim.
+    driver(|| unsafe { ffi::opensk_cc310_x25519_public(private.as_ptr(), value.as_mut_ptr()) })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+pub fn shared(private: &[u8; 32], public: &[u8; 32], output: &mut [u8; 32]) -> Result<(), Error> {
+    let mut value = Zeroizing::new([0; 32]);
+    // SAFETY: Fixed-size inputs and temporary output remain alive throughout the call.
+    driver(|| unsafe {
+        ffi::opensk_cc310_x25519_shared(private.as_ptr(), public.as_ptr(), value.as_mut_ptr())
+    })?;
+    if value.iter().all(|&x| x == 0) {
+        return Err(Error::user(0));
+    }
+    output.copy_from_slice(value.as_ref());
+    Ok(())
+}
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_x25519_generate(private: *mut u8) -> i32;
+        pub fn opensk_cc310_x25519_public(private: *const u8, public: *mut u8) -> i32;
+        pub fn opensk_cc310_x25519_shared(
+            private: *const u8, public: *const u8, shared: *mut u8,
+        ) -> i32;
+    }
+}
+#[cfg(test)]
+mod ffi {
+    use x25519_dalek::{PublicKey, StaticSecret};
+    pub unsafe fn opensk_cc310_x25519_generate(output: *mut u8) -> i32 {
+        unsafe { core::ptr::write_bytes(output, 0x42, 32) };
+        0
+    }
+    pub unsafe fn opensk_cc310_x25519_public(private: *const u8, public: *mut u8) -> i32 {
+        let private = StaticSecret::from(unsafe { *private.cast::<[u8; 32]>() });
+        let value = PublicKey::from(&private);
+        unsafe { core::ptr::copy_nonoverlapping(value.as_bytes().as_ptr(), public, 32) };
+        0
+    }
+    pub unsafe fn opensk_cc310_x25519_shared(
+        private: *const u8, public: *const u8, shared: *mut u8,
+    ) -> i32 {
+        let private = StaticSecret::from(unsafe { *private.cast::<[u8; 32]>() });
+        let public = PublicKey::from(unsafe { *public.cast::<[u8; 32]>() });
+        let value = private.diffie_hellman(&public);
+        unsafe { core::ptr::copy_nonoverlapping(value.as_bytes().as_ptr(), shared, 32) };
+        0
+    }
+}
