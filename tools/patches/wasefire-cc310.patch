diff --git a/crates/runner-nordic/crates/cc310/src/ed25519.rs b/crates/runner-nordic/crates/cc310/src/ed25519.rs
new file mode 100644
index 00000000..3c4caa98
--- /dev/null
+++ b/crates/runner-nordic/crates/cc310/src/ed25519.rs
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: Apache-2.0
+//! CC310 Ed25519 adapter. Private keys retain their existing 32-byte seed encoding.
+use core::alloc::Layout;
+
+use wasefire_board_api::crypto::ed25519::Api;
+use wasefire_board_api::{Error, Supported};
+use zeroize::{Zeroize, Zeroizing};
+
+use crate::{INVALID_SIGNATURE, driver, length};
+
+pub enum Ed25519 {}
+impl Supported for Ed25519 {}
+impl Api for Ed25519 {
+    const PRIVATE: Layout = Layout::new::<[u8; 32]>();
+    const PUBLIC: Layout = Layout::new::<[u8; 32]>();
+    const WRAPPED: usize = 32;
+    fn generate(output: &mut [u8]) -> Result<(), Error> {
+        length(output, 32)?;
+        let mut seed = Zeroizing::new([0; 32]);
+        // SAFETY: The serialized driver receives a writable 32-byte seed buffer.
+        driver(|| unsafe { ffi::opensk_cc310_ed25519_generate(seed.as_mut_ptr()) })?;
+        output.copy_from_slice(seed.as_ref());
+        Ok(())
+    }
+    fn public(private: &[u8], public: &mut [u8]) -> Result<(), Error> {
+        length(private, 32)?;
+        length(public, 32)?;
+        let mut value = [0; 32];
+        // SAFETY: Both buffers have the exact lengths required by the C shim.
+        driver(|| unsafe {
+            ffi::opensk_cc310_ed25519_public(private.as_ptr(), value.as_mut_ptr())
+        })?;
+        public.copy_from_slice(&value);
+        Ok(())
+    }
+    fn sign(
