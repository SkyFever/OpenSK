+#[test]
+fn signatures_are_prehash_and_cross_verify() {
+    let _test = TEST.lock().unwrap();
+    let digest = [0x42; 32];
+    let (mut r, mut s, mut public) = ([0; 32], [0; 32], [0; 64]);
+    <Impl as ecdsa::Api<32>>::sign(&key(13), &digest, &mut r, &mut s).unwrap();
+    <Impl as ecdsa::Api<32>>::public(&key(13), &mut public).unwrap();
+    assert!(<Impl as ecdsa::Api<32>>::verify(&public, &digest, &r, &s).unwrap());
+    let mut encoded = [4; 65];
+    encoded[1 ..].copy_from_slice(&public);
+    let verifying = VerifyingKey::from_sec1_bytes(&encoded).unwrap();
+    let signature = Signature::from_scalars(r, s).unwrap();
+    verifying.verify_prehash(&digest, &signature).unwrap();
+    assert!(!<Impl as ecdsa::Api<32>>::verify(&public, &[0x43; 32], &r, &s).unwrap());
+    r[0] ^= 1;
+    assert!(!<Impl as ecdsa::Api<32>>::verify(&public, &digest, &r, &s).unwrap());
