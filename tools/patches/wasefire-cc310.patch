@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: Apache-2.0
+#![allow(clippy::too_many_arguments)]
+use openssl::md::Md;
+use openssl::pkey::PKey;
+use openssl::pkey_ctx::PkeyCtx;
+use openssl::rsa::{Padding, Rsa};
+use openssl::sign::RsaPssSaltlen;
+pub unsafe fn opensk_cc310_rsa_generate(
+    bits: usize, output: *mut u8, size: usize, written: *mut usize,
+) -> i32 {
+    let value = Rsa::generate(bits as u32).unwrap().private_key_to_der().unwrap();
+    let output = unsafe { core::slice::from_raw_parts_mut(output, size) };
+    output[.. value.len()].copy_from_slice(&value);
+    unsafe { written.write(value.len()) };
+    0
+}
+pub unsafe fn opensk_cc310_rsa_public(
+    _bits: usize, key: *const u8, key_size: usize, output: *mut u8, size: usize,
+    written: *mut usize,
+) -> i32 {
+    let Ok(key) = Rsa::private_key_from_der(unsafe { core::slice::from_raw_parts(key, key_size) })
+    else {
+        return -135;
+    };
+    let value = key.public_key_to_der_pkcs1().unwrap();
+    let output = unsafe { core::slice::from_raw_parts_mut(output, size) };
+    output[.. value.len()].copy_from_slice(&value);
+    unsafe { written.write(value.len()) };
+    0
+}
+pub unsafe fn opensk_cc310_rsa_sign(
+    _bits: usize, pss: bool, key: *const u8, key_size: usize, digest: *const u8, output: *mut u8,
+    size: usize,
+) -> i32 {
+    let key = PKey::from_rsa(
+        Rsa::private_key_from_der(unsafe { core::slice::from_raw_parts(key, key_size) }).unwrap(),
+    )
+    .unwrap();
+    let mut ctx = PkeyCtx::new(&key).unwrap();
+    ctx.sign_init().unwrap();
+    ctx.set_rsa_padding(if pss { Padding::PKCS1_PSS } else { Padding::PKCS1 }).unwrap();
+    ctx.set_signature_md(Md::sha256()).unwrap();
+    if pss {
+        ctx.set_rsa_pss_saltlen(RsaPssSaltlen::DIGEST_LENGTH).unwrap();
+    }
+    ctx.sign(
+        unsafe { core::slice::from_raw_parts(digest, 32) },
+        Some(unsafe { core::slice::from_raw_parts_mut(output, size) }),
+    )
+    .unwrap();
+    0
+}
+pub unsafe fn opensk_cc310_rsa_verify(
+    _bits: usize, pss: bool, key: *const u8, key_size: usize, digest: *const u8, sig: *const u8,
+    size: usize,
+) -> i32 {
+    let key = PKey::from_rsa(
+        Rsa::public_key_from_der_pkcs1(unsafe { core::slice::from_raw_parts(key, key_size) })
+            .unwrap(),
+    )
+    .unwrap();
+    let mut ctx = PkeyCtx::new(&key).unwrap();
+    ctx.verify_init().unwrap();
+    ctx.set_rsa_padding(if pss { Padding::PKCS1_PSS } else { Padding::PKCS1 }).unwrap();
+    ctx.set_signature_md(Md::sha256()).unwrap();
+    if pss {
+        ctx.set_rsa_pss_saltlen(RsaPssSaltlen::DIGEST_LENGTH).unwrap();
+    }
+    match ctx.verify(unsafe { core::slice::from_raw_parts(digest, 32) }, unsafe {
+        core::slice::from_raw_parts(sig, size)
+    }) {
+        Ok(true) => 0,
+        _ => -149,
+    }
+}
+pub unsafe fn opensk_cc310_rsa_crypt(
+    _bits: usize, encrypt: bool, oaep: bool, key: *const u8, key_size: usize, label: *const u8,
+    label_size: usize, input: *const u8, input_size: usize, output: *mut u8, capacity: usize,
+    written: *mut usize,
+) -> i32 {
+    let key = unsafe { core::slice::from_raw_parts(key, key_size) };
+    let label = unsafe { core::slice::from_raw_parts(label, label_size) };
+    let input = unsafe { core::slice::from_raw_parts(input, input_size) };
+    let output = unsafe { core::slice::from_raw_parts_mut(output, capacity) };
+    macro_rules! setup {
+        ($ctx:ident) => {{
+            $ctx.set_rsa_padding(if oaep { Padding::PKCS1_OAEP } else { Padding::PKCS1 }).unwrap();
+            if oaep {
+                $ctx.set_rsa_oaep_md(Md::sha256()).unwrap();
+                $ctx.set_rsa_mgf1_md(Md::sha256()).unwrap();
+                if !label.is_empty() {
+                    $ctx.set_rsa_oaep_label(label).unwrap();
+                }
+            }
+        }};
+    }
+    let result = if encrypt {
+        let key = PKey::from_rsa(Rsa::public_key_from_der_pkcs1(key).unwrap()).unwrap();
+        let mut ctx = PkeyCtx::new(&key).unwrap();
+        ctx.encrypt_init().unwrap();
+        setup!(ctx);
+        ctx.encrypt(input, Some(output))
+    } else {
+        let key = PKey::from_rsa(Rsa::private_key_from_der(key).unwrap()).unwrap();
+        let mut ctx = PkeyCtx::new(&key).unwrap();
+        ctx.decrypt_init().unwrap();
+        setup!(ctx);
+        ctx.decrypt(input, Some(output))
+    };
+    match result {
+        Ok(size) => {
+            unsafe { written.write(size) };
+            0
+        }
+        Err(_) => -149,
+    }
+}
