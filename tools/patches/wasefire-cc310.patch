+#[cfg(feature = "cc310-self-test")]
+fn cc310_self_test() -> ! {
+    use embedded_hal::digital::OutputPin;
+    fn color(code: u32) {
+        with_state(|state| {
+            for (index, led) in state.leds.iter_mut().enumerate() {
+                if code & (1 << index) != 0 {
+                    let _ = led.set_low();
+                } else {
+                    let _ = led.set_high();
