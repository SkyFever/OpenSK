@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: Apache-2.0
+//! AES-128 primitives. CBC/ECB require whole blocks and use no padding.
+use alloc::vec;
+
+use typenum::{U4, U13, U16};
+use wasefire_board_api::crypto::aead::{self, AeadSupport, Array};
+use wasefire_board_api::{Error, Support};
+use zeroize::{Zeroize, Zeroizing};
+
+use crate::{driver, length};
+
+#[derive(Clone, Copy)]
+#[repr(u32)]
+pub enum Mode {
+    Ecb,
+    Cbc,
+    Ctr,
+}
+
+pub fn cipher(
+    mode: Mode, encrypt: bool, key: &[u8; 16], iv: &[u8; 16], input: &[u8], output: &mut [u8],
+) -> Result<(), Error> {
+    length(output, input.len())?;
+    if !matches!(mode, Mode::Ctr) && !input.len().is_multiple_of(16) {
+        return Err(Error::user(0));
+    }
+    let capacity = input.len().checked_add(16).ok_or(Error::user(0))?;
+    let mut value = Zeroizing::new(vec![0; capacity]);
+    // SAFETY: All slices are valid and the output includes a final-block reserve.
+    driver(|| unsafe {
+        ffi::opensk_cc310_aes128_cipher(
+            mode as u32,
+            encrypt,
+            key.as_ptr(),
+            iv.as_ptr(),
+            input.as_ptr(),
+            input.len(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value[.. input.len()]);
+    Ok(())
+}
+pub fn cmac(key: &[u8; 16], input: &[u8], output: &mut [u8; 16]) -> Result<(), Error> {
+    mac(true, key, input, output)
+}
+/// Raw CBC-MAC: callers must use a protocol that fixes or binds message length.
+pub fn cbc_mac(key: &[u8; 16], input: &[u8], output: &mut [u8; 16]) -> Result<(), Error> {
+    if input.is_empty() || !input.len().is_multiple_of(16) {
+        return Err(Error::user(0));
+    }
+    mac(false, key, input, output)
+}
+fn mac(cmac: bool, key: &[u8; 16], input: &[u8], output: &mut [u8; 16]) -> Result<(), Error> {
+    let mut value = Zeroizing::new([0; 16]);
+    // SAFETY: Keys and MACs are exactly one block and the input remains alive.
+    driver(|| unsafe {
+        ffi::opensk_cc310_aes128_mac(
+            cmac,
+            key.as_ptr(),
+            input.as_ptr(),
+            input.len(),
+            value.as_mut_ptr(),
+        )
+    })?;
+    output.copy_from_slice(value.as_ref());
+    Ok(())
+}
+fn validate_ccm(nonce: &[u8], size: usize, tag: usize) -> Result<(), Error> {
+    if !(7 ..= 13).contains(&nonce.len()) || !(4 ..= 16).contains(&tag) || !tag.is_multiple_of(2) {
+        return Err(Error::user(0));
+    }
+    let length_bits = 8 * (15 - nonce.len());
+    if length_bits < usize::BITS as usize && size >= 1usize << length_bits {
+        return Err(Error::user(0));
+    }
+    Ok(())
+}
+pub fn ccm_encrypt(
+    key: &[u8; 16], nonce: &[u8], aad: &[u8], input: &[u8], output: &mut [u8], tag: &mut [u8],
+) -> Result<(), Error> {
+    length(output, input.len())?;
+    validate_ccm(nonce, input.len(), tag.len())?;
+    let size = input.len().checked_add(tag.len()).ok_or(Error::user(0))?;
+    let mut value = Zeroizing::new(vec![0; size]);
+    // SAFETY: Combined output includes the exact requested authentication-tag size.
+    driver(|| unsafe {
+        ffi::opensk_cc310_aes128_ccm(
+            true,
+            key.as_ptr(),
+            nonce.as_ptr(),
+            nonce.len(),
+            aad.as_ptr(),
+            aad.len(),
+            input.as_ptr(),
+            input.len(),
+            value.as_mut_ptr(),
+            size,
+            tag.len(),
+        )
+    })?;
+    output.copy_from_slice(&value[.. input.len()]);
+    tag.copy_from_slice(&value[input.len() ..]);
+    Ok(())
+}
+pub fn ccm_decrypt(
+    key: &[u8; 16], nonce: &[u8], aad: &[u8], input: &[u8], tag: &[u8], output: &mut [u8],
+) -> Result<(), Error> {
+    length(output, input.len())?;
+    validate_ccm(nonce, input.len(), tag.len())?;
+    let mut combined =
+        Zeroizing::new(vec![0; input.len().checked_add(tag.len()).ok_or(Error::user(0))?]);
+    combined[.. input.len()].copy_from_slice(input);
+    combined[input.len() ..].copy_from_slice(tag);
+    let mut value = Zeroizing::new(vec![0; input.len()]);
+    // SAFETY: Ciphertext/tag and plaintext are separate, live, exactly sized buffers.
+    driver(|| unsafe {
+        ffi::opensk_cc310_aes128_ccm(
+            false,
+            key.as_ptr(),
+            nonce.as_ptr(),
+            nonce.len(),
+            aad.as_ptr(),
+            aad.len(),
+            combined.as_ptr(),
+            combined.len(),
+            value.as_mut_ptr(),
+            value.len(),
+            tag.len(),
+        )
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+/// CCM* without an authentication tag. Encryption/decryption use the same CTR operation.
+pub fn ccm_star_no_tag(
+    key: &[u8; 16], nonce: &[u8; 13], input: &[u8], output: &mut [u8],
+) -> Result<(), Error> {
+    // L=2 bounds the message length, and counter block 1 starts the payload stream.
+    if input.len() >= 65536 {
+        return Err(Error::user(0));
+    }
+    let mut counter = [0; 16];
+    counter[0] = 1;
+    counter[1 .. 14].copy_from_slice(nonce);
+    counter[15] = 1;
+    cipher(Mode::Ctr, true, key, &counter, input, output)
+}
+pub enum Aes128Ccm {}
+impl Support<AeadSupport> for Aes128Ccm {
+    const SUPPORT: AeadSupport = AeadSupport { no_copy: true, in_place_no_copy: true };
+}
+impl aead::Api<U16, U13> for Aes128Ccm {
+    type Tag = U4;
+    fn encrypt(
+        key: &Array<U16>, iv: &Array<U13>, aad: &[u8], clear: Option<&[u8]>, cipher: &mut [u8],
+        tag: &mut Array<U4>,
+    ) -> Result<(), Error> {
+        if let Some(clear) = clear {
+            length(clear, cipher.len())?;
+        }
+        validate_ccm(iv, cipher.len(), 4)?;
+        let input = clear.map_or(cipher.as_ptr(), |x| x.as_ptr());
+        // SAFETY: Exact aliasing is the PSA in-place convention. No partial overlap is possible.
+        let result = driver(|| unsafe {
+            ffi::opensk_cc310_ccm_detached(
+                true,
+                key.as_ptr(),
+                iv.as_ptr(),
+                aad.as_ptr(),
+                aad.len(),
+                input,
+                cipher.len(),
+                cipher.as_mut_ptr(),
+                tag.as_mut_ptr(),
+            )
+        });
+        if result.is_err() {
+            cipher.zeroize();
+            tag.zeroize();
+        }
+        result
+    }
+    fn decrypt(
+        key: &Array<U16>, iv: &Array<U13>, aad: &[u8], cipher: Option<&[u8]>, tag: &Array<U4>,
+        clear: &mut [u8],
+    ) -> Result<(), Error> {
+        if let Some(cipher) = cipher {
+            length(cipher, clear.len())?;
+        }
+        validate_ccm(iv, clear.len(), 4)?;
+        let input = cipher.map_or(clear.as_ptr(), |x| x.as_ptr());
+        let mut tag = *tag;
+        // SAFETY: Exact in-place aliasing is allowed; the tag has an independent mutable copy.
+        let result = driver(|| unsafe {
+            ffi::opensk_cc310_ccm_detached(
+                false,
+                key.as_ptr(),
+                iv.as_ptr(),
+                aad.as_ptr(),
+                aad.len(),
+                input,
+                clear.len(),
+                clear.as_mut_ptr(),
+                tag.as_mut_ptr(),
+            )
+        });
+        if result.is_err() {
+            clear.zeroize();
+        }
+        result
+    }
+}
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_ccm_detached(
+            encrypt: bool, key: *const u8, nonce: *const u8, aad: *const u8, aad_size: usize,
+            input: *const u8, size: usize, output: *mut u8, tag: *mut u8,
+        ) -> i32;
+        pub fn opensk_cc310_aes128_cipher(
+            mode: u32, encrypt: bool, key: *const u8, iv: *const u8, input: *const u8, size: usize,
+            output: *mut u8, capacity: usize,
+        ) -> i32;
+        pub fn opensk_cc310_aes128_mac(
+            cmac: bool, key: *const u8, input: *const u8, size: usize, output: *mut u8,
+        ) -> i32;
+        pub fn opensk_cc310_aes128_ccm(
+            encrypt: bool, key: *const u8, nonce: *const u8, nonce_size: usize, aad: *const u8,
+            aad_size: usize, input: *const u8, input_size: usize, output: *mut u8,
+            output_size: usize, tag_size: usize,
+        ) -> i32;
+    }
+}
