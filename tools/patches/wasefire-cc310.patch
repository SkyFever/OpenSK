@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Common device cross-checks and finite benchmarks; never accesses credential storage.
+//! RustCrypto is deliberately linked here as a reference, only in this test applet.
+#![no_std]
+wasefire::applet!();
+
+#[cfg(not(feature = "test"))]
+use aes::cipher::{BlockEncrypt, KeyInit};
+use hmac::Mac;
+use p256::ecdsa::signature::hazmat::{PrehashSigner, PrehashVerifier};
+use sha2::Digest as _;
+use wasefire::crypto::{ecdh, ecdsa, hash};
+
+const MESSAGE: &[u8] = b"OpenSK software/Nordic interoperability";
+const SAMPLES: u64 = 20;
+
+fn scalar(n: u8) -> [u8; 32] {
+    let mut result = [0; 32];
+    result[31] = n;
+    result
+}
+
+pub fn main() -> ! {
+    debug!(
+        "backend={} reference=RustCrypto",
+        if cfg!(feature = "nordic") { "Nordic" } else { "software" }
+    );
+    p256_checks();
+    symmetric_checks();
+    #[cfg(feature = "ed25519")]
+    ed25519_checks();
+    debug!("CROSS-CHECK PASS");
+    benchmark();
+    debug!("BENCHMARK COMPLETE");
+    scheduling::exit();
+}
+
+fn p256_checks() {
+    let a = scalar(1);
+    let b = scalar(2);
+    let digest: [u8; 32] = sha2::Sha256::digest(MESSAGE).into();
+    let reference = p256::ecdsa::SigningKey::from_slice(&a).unwrap();
+    let reference_public = reference.verifying_key();
+    let key = ecdsa::Private::<ecdsa::P256>::import(&a).unwrap();
+    assert_eq!(&*key.export().unwrap(), &a);
+    let public = key.public().unwrap();
+    let mut x = [0; 32];
+    let mut y = [0; 32];
+    public.export(&mut x, &mut y).unwrap();
+    let point = reference_public.to_encoded_point(false);
+    assert_eq!(&x, point.x().unwrap().as_slice());
+    assert_eq!(&y, point.y().unwrap().as_slice());
+
+    let signature: p256::ecdsa::Signature = reference.sign_prehash(&digest).unwrap();
+    reference_public.verify_prehash(&digest, &signature).unwrap();
+    let bytes = signature.to_bytes();
+    assert!(public.verify_prehash(&digest, &bytes[.. 32], &bytes[32 ..]).unwrap());
+    let mut r = [0; 32];
+    let mut s = [0; 32];
+    key.sign_prehash(&digest, &mut r, &mut s).unwrap();
+    assert!(public.verify_prehash(&digest, &r, &s).unwrap());
+    reference_public
+        .verify_prehash(&digest, &p256::ecdsa::Signature::from_scalars(r, s).unwrap())
+        .unwrap();
+    let mut wrong = digest;
+    wrong[0] ^= 1;
+    assert!(!public.verify_prehash(&wrong, &r, &s).unwrap());
+    assert!(public.verify_prehash(&digest[.. 31], &r, &s).is_err());
+    // Software imports raw storage; invalid scalars are rejected when used.
+    if let Ok(invalid) = ecdsa::Private::<ecdsa::P256>::import(&[0; 32]) {
+        assert!(invalid.public().is_err());
+    }
+    if let Ok(invalid) = ecdsa::Public::<ecdsa::P256>::import(&[0; 32], &[0; 32]) {
+        assert!(invalid.verify_prehash(&digest, &r, &s).is_err());
+    }
+    let generated = ecdsa::Private::<ecdsa::P256>::generate().unwrap();
+    p256::SecretKey::from_slice(&generated.export().unwrap()).unwrap();
+
+    let ra = p256::SecretKey::from_slice(&a).unwrap();
+    let rb = p256::SecretKey::from_slice(&b).unwrap();
+    let expected = p256::ecdh::diffie_hellman(ra.to_nonzero_scalar(), rb.public_key().as_affine());
+    let reverse = p256::ecdh::diffie_hellman(rb.to_nonzero_scalar(), ra.public_key().as_affine());
+    assert_eq!(expected.raw_secret_bytes(), reverse.raw_secret_bytes());
+    let ka = ecdh::Private::<ecdh::P256>::import_testonly(&a).unwrap();
+    let kb = ecdh::Private::<ecdh::P256>::import_testonly(&b).unwrap();
+    for (private, public) in [(&ka, kb.public().unwrap()), (&kb, ka.public().unwrap())] {
+        let shared = ecdh::Shared::<ecdh::P256>::new(private, &public).unwrap();
+        let mut actual = [0; 32];
+        shared.export(&mut actual).unwrap();
+        assert_eq!(&actual, expected.raw_secret_bytes().as_slice());
+    }
+    if let Ok(invalid) = ecdh::Public::<ecdh::P256>::import(&[0; 32], &[0; 32]) {
+        assert!(ecdh::Shared::<ecdh::P256>::new(&ka, &invalid).is_err());
+    }
+    debug!("P256 four signature paths, both ECDH directions, invalid inputs: PASS");
+}
+
+fn symmetric_checks() {
+    // Wasefire's host stub has no CBC symbols; device builds run this section.
+    #[cfg(not(feature = "test"))]
+    {
+        let key = [0x42; 32];
+        let iv = [0x24; 16];
+        let plaintext = [0x5a; 64];
+        let cipher = aes::Aes256::new((&key).into());
+        let mut expected = plaintext;
+        let mut previous = iv;
+        for block in expected.chunks_exact_mut(16) {
+            for (byte, mask) in block.iter_mut().zip(previous) {
+                *byte ^= mask;
+            }
+            cipher.encrypt_block(block.into());
+            previous.copy_from_slice(block);
+        }
+        let mut actual = plaintext;
+        crypto::cbc::encrypt(&key, &iv, &mut actual).unwrap();
+        assert_eq!(actual, expected);
+        crypto::cbc::decrypt(&key, &iv, &mut actual).unwrap();
+        assert_eq!(actual, plaintext);
+        assert!(crypto::cbc::encrypt(&key, &iv, &mut [0; 17]).is_err());
+    }
+    assert_eq!(hash::sha256(b"abc").unwrap().as_slice(), sha2::Sha256::digest(b"abc").as_slice());
+    // Exercise independent contexts, long/empty HMAC keys and non-block-sized updates.
+    for key in [&[][..], &[0x0b; 20][..], &[0xaa; 131][..]] {
+        let mut reference = <hmac::Hmac<sha2::Sha256> as Mac>::new_from_slice(key).unwrap();
+        reference.update(MESSAGE);
+        let mut actual = [0; 32];
+        hash::Hmac::hmac(hash::Algorithm::Sha256, key, MESSAGE, &mut actual).unwrap();
+        assert_eq!(actual.as_slice(), reference.finalize().into_bytes().as_slice());
+    }
+    let mut a = hash::Digest::new(hash::Algorithm::Sha256).unwrap();
+    let mut b = hash::Digest::new(hash::Algorithm::Sha256).unwrap();
+    a.update(b"a");
+    b.update(b"");
+    a.update(b"bc");
+    let mut actual = [0; 32];
+    a.finalize(&mut actual).unwrap();
+    assert_eq!(actual, hash::sha256(b"abc").unwrap());
+    b.finalize(&mut actual).unwrap();
+    assert_eq!(actual, hash::sha256(b"").unwrap());
+    debug!("SHA256 and HMAC cross-checks: PASS");
+    #[cfg(not(feature = "test"))]
+    debug!("AES-CBC cross-checks: PASS");
+    #[cfg(feature = "test")]
+    debug!("AES-CBC host stub: SKIP (no implementation)");
+}
+
+#[cfg(feature = "ed25519")]
+fn ed25519_checks() {
+    use ed25519_dalek::{Signer, Verifier};
+    let seed = [0x42; 32];
+    let reference = ed25519_dalek::SigningKey::from_bytes(&seed);
+    let key = crypto::ed25519::Private::import(&seed).unwrap();
+    assert_eq!(&*key.export().unwrap(), &seed);
+    let public = key.public().unwrap();
+    let mut actual = [0; 32];
+    public.export(&mut actual).unwrap();
+    assert_eq!(&actual, reference.verifying_key().as_bytes());
+    let signature = reference.sign(MESSAGE);
+    let bytes = signature.to_bytes();
+    assert!(
+        public
+            .verify(MESSAGE, bytes[.. 32].try_into().unwrap(), bytes[32 ..].try_into().unwrap())
+            .unwrap()
+    );
+    let mut r = [0; 32];
+    let mut s = [0; 32];
+    key.sign(MESSAGE, &mut r, &mut s).unwrap();
+    assert!(public.verify(MESSAGE, &r, &s).unwrap());
+    let mut signature = [0; 64];
+    signature[.. 32].copy_from_slice(&r);
+    signature[32 ..].copy_from_slice(&s);
+    reference
+        .verifying_key()
+        .verify(MESSAGE, &ed25519_dalek::Signature::from_bytes(&signature))
+        .unwrap();
+    assert!(!public.verify(b"wrong", &r, &s).unwrap());
+    debug!("Ed25519 cross-check: PASS (Nordic Ed25519 is Oberon SOFTWARE)");
+}
+
+fn measure(name: &str, mut operation: impl FnMut()) {
+    operation(); // Warm-up outside the measured interval.
+    let start = clock::uptime_us().unwrap();
+    for _ in 0 .. SAMPLES {
+        operation();
+    }
+    let elapsed = clock::uptime_us().unwrap() - start;
+    debug!("BENCH op={name} samples={SAMPLES} total_us={elapsed} mean_us={}", elapsed / SAMPLES);
+}
+
+fn benchmark() {
+    let key = ecdsa::Private::<ecdsa::P256>::import(&scalar(1)).unwrap();
+    let public = key.public().unwrap();
+    let digest = hash::sha256(MESSAGE).unwrap();
+    let mut r = [0; 32];
+    let mut s = [0; 32];
+    key.sign_prehash(&digest, &mut r, &mut s).unwrap();
+    measure("p256_keygen", || {
+        core::hint::black_box(ecdsa::Private::<ecdsa::P256>::generate().unwrap());
+    });
+    measure("ecdsa_sign_prehash", || {
+        key.sign_prehash(&digest, &mut r, &mut s).unwrap();
+    });
+    measure("ecdsa_verify_prehash", || {
+        assert!(public.verify_prehash(&digest, &r, &s).unwrap());
+    });
+    let a = ecdh::Private::<ecdh::P256>::import_testonly(&scalar(1)).unwrap();
+    let b = ecdh::Private::<ecdh::P256>::import_testonly(&scalar(2)).unwrap().public().unwrap();
+    measure("ecdh", || {
+        core::hint::black_box(ecdh::Shared::<ecdh::P256>::new(&a, &b).unwrap());
+    });
+    measure("aes256_cbc_256B", || {
+        let mut blocks = [0x5a; 256];
+        crypto::cbc::encrypt(&[0x42; 32], &[0x24; 16], &mut blocks).unwrap();
+        core::hint::black_box(blocks);
+    });
+    measure("hmac_sha256_256B", || {
+        let mut output = [0; 32];
+        hash::Hmac::hmac(hash::Algorithm::Sha256, &[0x42; 32], &[0x5a; 256], &mut output).unwrap();
+        core::hint::black_box(output);
+    });
+}
+
+#[cfg(feature = "test")]
+use wasefire_stub as _;
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn software_stub_p256_cross_checks() {
+        p256_checks();
+    }
+    #[test]
+    fn software_stub_symmetric_cross_checks() {
+        symmetric_checks();
+    }
+    #[cfg(feature = "ed25519")]
+    #[test]
+    fn software_stub_ed25519_cross_checks() {
+        ed25519_checks();
+    }
+}
