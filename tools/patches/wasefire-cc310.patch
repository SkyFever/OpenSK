+// SPDX-License-Identifier: Apache-2.0
+//! IETF ChaCha20-Poly1305 with a 256-bit key, 96-bit nonce and 128-bit tag.
+use alloc::vec;
+
+use wasefire_board_api::Error;
+use zeroize::Zeroizing;
+
+use crate::{driver, length};
+
+/// Nonces must be unique for every encryption under a key.
+pub fn encrypt(
+    key: &[u8; 32], nonce: &[u8; 12], aad: &[u8], input: &[u8], output: &mut [u8],
+    tag: &mut [u8; 16],
+) -> Result<(), Error> {
+    length(output, input.len())?;
+    let size = input.len().checked_add(16).ok_or(Error::user(0))?;
+    let mut value = Zeroizing::new(vec![0; size]);
+    // SAFETY: Output has capacity for both ciphertext and the 16-byte tag.
+    driver(|| unsafe {
+        ffi::opensk_cc310_chachapoly(
+            true,
+            key.as_ptr(),
+            nonce.as_ptr(),
+            aad.as_ptr(),
+            aad.len(),
+            input.as_ptr(),
+            input.len(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value[.. input.len()]);
+    tag.copy_from_slice(&value[input.len() ..]);
+    Ok(())
+}
+pub fn decrypt(
+    key: &[u8; 32], nonce: &[u8; 12], aad: &[u8], input: &[u8], tag: &[u8; 16], output: &mut [u8],
+) -> Result<(), Error> {
+    length(output, input.len())?;
+    let size = input.len().checked_add(16).ok_or(Error::user(0))?;
+    let mut combined = Zeroizing::new(vec![0; size]);
+    combined[.. input.len()].copy_from_slice(input);
+    combined[input.len() ..].copy_from_slice(tag);
+    let mut value = Zeroizing::new(vec![0; input.len()]);
+    // SAFETY: Input includes the authentication tag; unverified output stays in a wiped temporary.
+    driver(|| unsafe {
+        ffi::opensk_cc310_chachapoly(
+            false,
+            key.as_ptr(),
+            nonce.as_ptr(),
+            aad.as_ptr(),
+            aad.len(),
+            combined.as_ptr(),
+            combined.len(),
+            value.as_mut_ptr(),
+            value.len(),
+        )
+    })?;
+    output.copy_from_slice(&value);
+    Ok(())
+}
+#[cfg(not(test))]
+mod ffi {
+    unsafe extern "C" {
+        pub fn opensk_cc310_chachapoly(
+            encrypt: bool, key: *const u8, nonce: *const u8, aad: *const u8, aad_size: usize,
+            input: *const u8, input_size: usize, output: *mut u8, output_size: usize,
+        ) -> i32;
+    }
+}
+#[cfg(test)]
+mod ffi {
+    use chacha20poly1305::aead::{AeadInPlace, KeyInit};
+    #[allow(clippy::too_many_arguments)]
+    pub unsafe fn opensk_cc310_chachapoly(
+        encrypt: bool, key: *const u8, nonce: *const u8, aad: *const u8, aad_size: usize,
+        input: *const u8, input_size: usize, output: *mut u8, output_size: usize,
+    ) -> i32 {
+        let key = unsafe { &*key.cast::<[u8; 32]>() };
+        let nonce = unsafe { &*nonce.cast::<[u8; 12]>() };
+        let aad = unsafe { core::slice::from_raw_parts(aad, aad_size) };
+        let input = unsafe { core::slice::from_raw_parts(input, input_size) };
+        let output = unsafe { core::slice::from_raw_parts_mut(output, output_size) };
+        let ctx = chacha20poly1305::ChaCha20Poly1305::new(key.into());
+        if encrypt {
+            output[.. input_size].copy_from_slice(input);
+            let tag = ctx
+                .encrypt_in_place_detached(nonce.into(), aad, &mut output[.. input_size])
+                .unwrap();
+            output[input_size ..].copy_from_slice(&tag);
+        } else {
+            output.copy_from_slice(&input[.. output_size]);
+            if ctx
+                .decrypt_in_place_detached(nonce.into(), aad, output, input[output_size ..].into())
+                .is_err()
+            {
+                return -149;
+            }
+        }
+        0
+    }
+}
