         assert_eq!(&a, public);
+        let (mut signed_r, mut signed_s) = ([0; 32], [0; 32]);
+        private.sign(message, &mut signed_r, &mut signed_s).unwrap();
+        assert_eq!(&signed_r, &signature[.. 32]);
