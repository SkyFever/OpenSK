+++ b/crates/runner-nordic/src/board/crypto.rs
@@ -17,9 +17,40 @@ use wasefire_board_api::crypto;
 #[cfg(feature = "aes128-ccm")]
 mod ccm;
 
+#[cfg(all(
+    feature = "hardware-crypto-p256",
+    any(
+        feature = "software-crypto-p256",
