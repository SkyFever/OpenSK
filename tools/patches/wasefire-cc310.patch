+// PSA requests use the existing nRF52840 RNG. The pinned Nordic ECC driver
+// also has an internal CTR-DRBG with its own CryptoCell entropy source.
+#[cfg(all(
+    not(feature = "hardware-crypto-rng"),
+    any(
+        feature = "hardware-crypto-p256",
+        feature = "hardware-crypto-symmetric",
+        feature = "hardware-crypto-ed25519",
+        feature = "hardware-crypto-aes128-ccm"
+    )
+))]
+#[unsafe(no_mangle)]
+unsafe extern "C" fn psa_generate_random(output: *mut u8, size: usize) -> i32 {
+    if size == 0 {
+        return 0;
+    }
+    if output.is_null() || size > isize::MAX as usize {
+        return -135; // PSA_ERROR_INVALID_ARGUMENT
+    }
+    // SAFETY: The driver supplies a writable output allocation of size bytes.
+    let output = unsafe { core::slice::from_raw_parts_mut(output, size) };
+    match <crate::board::rng::Impl as wasefire_board_api::rng::Api>::fill_bytes(output) {
+        Ok(()) => 0,
+        Err(_) => -148, // PSA_ERROR_INSUFFICIENT_ENTROPY
+    }
+}
+
+// Makerdiary LED order is red P0.23, green P0.22, blue P0.24 (active low).
+// Display a three-bit operation code until its call returns. Preserve the first
+// returned error across destructors so cleanup cannot hide the failing call.
+#[cfg(all(feature = "cc310-trace", not(feature = "board-makerdiary")))]
+compile_error!("cc310-trace requires the Makerdiary RGB LED");
+
+#[cfg(feature = "cc310-trace")]
+#[unsafe(no_mangle)]
+extern "C" fn opensk_cc310_trace(operation: u32) {
+    use core::sync::atomic::{AtomicBool, Ordering};
+
+    use embedded_hal::digital::OutputPin;
+
+    static FAILED: AtomicBool = AtomicBool::new(false);
+    if FAILED.load(Ordering::Relaxed) {
+        return;
+    }
+    if operation & (1 << 31) != 0 {
+        FAILED.store(true, Ordering::Relaxed);
+    }
+    crate::with_state(|state| {
+        for (index, led) in state.leds.iter_mut().enumerate() {
+            if operation & (1 << index) != 0 {
+                let _ = led.set_low();
+            } else {
+                let _ = led.set_high();
+            }
+        }
+    });
+}
